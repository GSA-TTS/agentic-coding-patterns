{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acq-provider-input-bundle",
  "title": "ACQ Provider Input Bundle",
  "description": "Host-time manifest for a provider kit. Artifact paths are package-relative. v1 declares its legacy fixed guest projectedPath; v2 declares the stable provider-relative providerPath, which consumers compose beneath their backend-supplied read-only root. credentialEnvNames declares credential names only; it never assigns values in the guest environment. This manifest contains no credentials or harness configuration.",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "providerId": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?(?![\\s\\S])"},
    "credentialEnvNames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"}},
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {"const": "acq-provider-input-bundle/v1"},
        "providerId": {"$ref": "#/$defs/providerId"},
        "factsPath": {"type": "string", "minLength": 1, "maxLength": 256},
        "normalizerPath": {"type": "string", "minLength": 1, "maxLength": 256},
        "snapshotPath": {"type": "string", "minLength": 1, "maxLength": 256},
        "projectedPath": {"type": "string", "pattern": "^/var/lib/acq/host/models/providers/[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?(?![\\s\\S])"},
        "credentialEnvNames": {"$ref": "#/$defs/credentialEnvNames"}
      },
      "required": ["schemaVersion", "providerId", "factsPath", "normalizerPath", "snapshotPath", "projectedPath", "credentialEnvNames"]
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {"const": "acq-provider-input-bundle/v2"},
        "providerId": {"$ref": "#/$defs/providerId"},
        "factsPath": {"type": "string", "minLength": 1, "maxLength": 256},
        "normalizerPath": {"type": "string", "minLength": 1, "maxLength": 256},
        "snapshotPath": {"type": "string", "minLength": 1, "maxLength": 256},
        "providerPath": {"type": "string", "pattern": "^models/providers/[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?(?![\\s\\S])"},
        "credentialEnvNames": {"$ref": "#/$defs/credentialEnvNames"}
      },
      "required": ["schemaVersion", "providerId", "factsPath", "normalizerPath", "snapshotPath", "providerPath", "credentialEnvNames"]
    }
  }
}
