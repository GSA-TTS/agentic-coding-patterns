{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acq-provider-input-bundle/v3",
  "title": "ACQ Provider Input Bundle v3",
  "description": "Data-only provider manifest selecting a trusted discovery adapter. No provider executable or mapping language is accepted. Every materializer MUST invoke scripts/validate_provider_input_contract.py for cross-field, file, symlink, credential, and URL checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "factsPath", "snapshotPath", "providerPath", "credentialEnvNames", "discovery"],
  "properties": {
    "schemaVersion": {"const": "acq-provider-input-bundle/v3"},
    "providerId": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?(?![\\s\\S])"},
    "factsPath": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])"},
    "snapshotPath": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*(?![\\s\\S])"},
    "providerPath": {"type": "string", "pattern": "^models/providers/[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?(?![\\s\\S])"},
    "credentialEnvNames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"}},
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"type": "string", "enum": ["usai-openai-list/v1"]}
      }
    }
  }
}
