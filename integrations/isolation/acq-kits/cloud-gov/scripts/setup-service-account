#!/usr/bin/env bash
#
# setup-service-account - host-side setup of a cloud.gov service account for the
# cloud-gov kit, so an agent sandbox is bound to its own narrow credential
# instead of your full-scope `cf oauth-token`.
#
# Run it on the HOST (never in the sandbox) from a shell where you are already
# logged in as yourself (`cf login -a https://api.fr.cloud.gov --sso`) and have
# targeted the org and space the agent should reach. It:
#   1. creates a `cloud-gov-service-account` instance in that space (plan
#      space-auditor by default, read-only; space-deployer only with --plan);
#   2. creates a service key and reads its username/password in-process (never
#      on argv, in history, in a log, or in the sandbox);
#   3. authenticates that account into a SEPARATE private CF_HOME (mode 0700,
#      outside the working directory) so your own `cf` session is untouched;
#   4. hands a token from that CF_HOME to `acq secret set` on stdin, bound to
#      api.fr.cloud.gov. acq alone decides how the active backend stores and
#      injects it, so the sandbox only ever sees acq's placeholder. This script
#      never names or calls a backend.
# It never prints the token, the username, or the password.
#
# STATUS: written from cloud.gov's and the CLIs' documentation, NOT run against
# cloud.gov or acq. Everything below is UNTESTED against the real services (the
# tests use stub `cf` and `acq`). See "UNTESTED" in --help.
#
# Bash 3.2 compatible (macOS). Needs: bash, python3, cf, acq.

set -euo pipefail

# Never trace this script: xtrace would print the token variable and the commands
# handling it to stderr. This also covers `bash -x` and an inherited SHELLOPTS.
{ set +x; } 2>/dev/null
unset BASH_XTRACEFD

# CF_TRACE would make cf print request bodies, including credentials and tokens.
unset CF_TRACE CF_USERNAME CF_PASSWORD

CLOUD_GOV_API="https://api.fr.cloud.gov"
CLOUD_GOV_HOST="api.fr.cloud.gov"
SERVICE_OFFERING="cloud-gov-service-account"
MARKER=".cloud-gov-acq-kit-service-account"

EX_USAGE=2
EX_REFUSED=3
EX_DECLINED=4
EX_FAILED=5

usage() {
  cat <<'EOF'
Usage: setup-service-account [options]

Set up a cloud.gov service account for an agent sandbox and give a token from it
to `acq secret set` for api.fr.cloud.gov. Run on the host, logged in as yourself
with the target org and space selected (`cf target`). Which backend stores the
token, and how, is acq's business: set your backend with acq as usual; this
script takes no backend option.

Options:
  --sandbox NAME      Scope the binding to this sandbox (acq's per-sandbox
                      scope). One of --sandbox or --global is required.
  --global            Bind for ALL sandboxes (acq's -g scope). Deliberate and
                      explicit; prints the authority warning. Not the default.
  --plan PLAN         space-auditor (default, read-only) or space-deployer
                      (can deploy; use only when the agent must deploy).
  --name NAME         Service instance name. Default:
                      cloud-gov-agent-<sandbox|global>-<auditor|deployer>.
                      An existing instance is reused only if it is the
                      cloud-gov-service-account service with the requested plan;
                      otherwise the script stops.
  --key-name NAME     Service key name. Default: <instance name>-key.
  --cf-home DIR       Private CF_HOME for the service-account session. Must be
                      an absolute path outside the working directory and outside
                      any git work tree. Default:
                      $HOME/.cf-cloud-gov-agent/<instance name>
  --rotate            Rotate the service KEY: delete it, create a new one,
                      re-authenticate, and rebind. Without it a re-run never
                      creates a second key.
  --refresh           Re-read a token from the existing private CF_HOME and
                      rebind it, touching no key, instance, or password and
                      needing no cf login of yours. Use it when a bound token
                      has expired. If it fails, re-run without it.
  --dry-run           Show the plan after read-only checks; change nothing.
  --yes               Do not ask for confirmation. Without it, the script asks
                      on a terminal and refuses when stdin is not a terminal.
  -h, --help          Show this help.

Token expiry: the value acq stores is a static token read once. A service-account
token can expire; when it does, re-run this script (or use --refresh) to read a
fresh one from the private CF_HOME and rebind it through acq. Whether
`cf oauth-token` yields a fresh token for that session is UNTESTED. Passwords
expire after 90 days (as cloud.gov documents); rotate the key then with --rotate.

Exit codes:
  0  success (or dry-run completed)
  2  usage error (bad or missing option)
  3  refused before changing anything: precondition failed or state ambiguous
  4  not confirmed (answered no, or no terminal and no --yes)
  5  failed after changes began; the message says what exists and what to do

Safety properties (the tests check these with stub cf/acq and a canary
credential):
  - The script never puts the service-key username/password or the token on a
    command line, in its output, or in a file it writes itself. The password is
    read from `cf service-key` output by a python3 process and passed to `cf auth`
    only through that child process's environment. (`cf` itself keeps its session
    tokens in the 0700 CF_HOME; where and how is UNTESTED, see below.) Tracing is
    switched off so xtrace cannot print them.
  - The token goes to `acq secret set` on stdin only. This script runs no
    backend command of its own; if acq fails, its message is shown and the
    script stops.
  - CF_TRACE is unset in this script's environment to reduce the chance that cf
    logs credentials; cf settings in your own config may still apply (UNTESTED).
  - A failed `cf auth`, or a failed `acq secret set`, removes a CF_HOME and a
    service key this run created and leaves nothing bound. (An instance this run
    created is left in place; re-running reuses it.)
  - An existing CF_HOME is used only if it carries this script's marker file,
    is owned by you, and is mode 0700.

UNTESTED (written from documentation; none of this was run against cloud.gov,
acq - treat every item as an assumption to check on first use):
  - `cf auth` with no arguments reading CF_USERNAME and CF_PASSWORD from the
    environment (and so keeping the password off argv).
  - CF_HOME relocating the cf CLI config, leaving your own session unchanged.
  - The shape of `cf service-key` output: header line(s), then JSON with
    "username" and "password" (optionally nested under "credentials").
  - The output formats of `cf service` (offering/plan lines), `cf service-keys`,
    and `cf target`, and the "not found" text, which the script parses.
  - The plan names space-auditor and space-deployer, and the service name
    cloud-gov-service-account, as given in cloud.gov's documentation.
  - Where `cf auth` stores the session's tokens inside CF_HOME.
  - `cf oauth-token` working, and refreshing, for a service-account session.
  - `acq secret set [-g|SANDBOX] cloud-gov --host api.fr.cloud.gov --env
    CF_OAUTH_TOKEN` reading the token from stdin, accepting a sandbox that does
    not exist yet, and injecting the value on whichever backend acq uses.
    Run scripts/verify afterwards to check that the placeholder reaches the API.
  - That a service-account token stops working when its key is deleted.

Whether an AI agent acting through a service account is acceptable under your
agency's policy is a question for your ISSO. Nothing here claims approval.
cloud.gov says not to use service-account credentials to log in as a human.
EOF
}

die() {
  local code="$1"
  shift
  printf 'setup-service-account: %s\n' "$*" >&2
  exit "$code"
}

SANDBOX=""
GLOBAL=0
PLAN="space-auditor"
INST_NAME=""
KEY_NAME=""
CF_HOME_ARG=""
ROTATE=0
REFRESH=0
DRY_RUN=0
YES=0

need_val() { [ "$#" -ge 2 ] && [ -n "$2" ] || die "$EX_USAGE" "$1 needs a value (see --help)"; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --sandbox) need_val "$@"; SANDBOX="$2"; shift 2 ;;
    --global) GLOBAL=1; shift ;;
    --plan) need_val "$@"; PLAN="$2"; shift 2 ;;
    --name) need_val "$@"; INST_NAME="$2"; shift 2 ;;
    --key-name) need_val "$@"; KEY_NAME="$2"; shift 2 ;;
    --cf-home) need_val "$@"; CF_HOME_ARG="$2"; shift 2 ;;
    --rotate) ROTATE=1; shift ;;
    --refresh) REFRESH=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes) YES=1; shift ;;
    -h | --help) usage; exit 0 ;;
    *) die "$EX_USAGE" "unknown option: $1 (see --help)" ;;
  esac
done

NAME_RE='^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$'
SAFE_PATH_RE='^/[A-Za-z0-9._/@+=,:-]+$'

if [ "$REFRESH" = "1" ] && [ "$ROTATE" = "1" ]; then
  die "$EX_USAGE" "--refresh and --rotate are mutually exclusive"
fi
case "$PLAN" in
  space-auditor | space-deployer) ;;
  *) die "$EX_USAGE" "--plan must be space-auditor or space-deployer" ;;
esac
if [ "$GLOBAL" = "1" ] && [ -n "$SANDBOX" ]; then
  die "$EX_USAGE" "--global and --sandbox are mutually exclusive"
fi
if [ "$GLOBAL" = "0" ] && [ -z "$SANDBOX" ]; then
  die "$EX_USAGE" "scope required: pass --sandbox NAME, or --global to bind for every sandbox"
fi
if [ -n "$SANDBOX" ] && ! printf '%s' "$SANDBOX" | grep -Eq "$NAME_RE"; then
  die "$EX_USAGE" "--sandbox must match $NAME_RE"
fi

plan_short="${PLAN#space-}"
scope_label="${SANDBOX:-global}"
[ -n "$INST_NAME" ] || INST_NAME="cloud-gov-agent-${scope_label}-${plan_short}"
[ -n "$KEY_NAME" ] || KEY_NAME="${INST_NAME}-key"
for v in "$INST_NAME" "$KEY_NAME"; do
  printf '%s' "$v" | grep -Eq "$NAME_RE" || die "$EX_USAGE" "name '$v' must match $NAME_RE"
done
case "$KEY_NAME" in name | Getting) die "$EX_USAGE" "key name '$KEY_NAME' collides with cf output headings" ;; esac

# ---- prerequisites (read-only) ------------------------------------------------
command -v python3 >/dev/null 2>&1 || die "$EX_REFUSED" "python3 is required (it parses the service key in-process)"
CF_BIN="$(command -v cf 2>/dev/null || true)"
case "$CF_BIN" in
  /*) ;;
  *) die "$EX_REFUSED" "cf not found on PATH as an executable (install the CF CLI)" ;;
esac
command -v acq >/dev/null 2>&1 || die "$EX_REFUSED" "acq not found on PATH; it is the only secret store this script uses"

canon() { python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"; }

if [ -z "$CF_HOME_ARG" ]; then
  [ -n "${HOME:-}" ] || die "$EX_REFUSED" "HOME is unset; pass --cf-home"
  CF_HOME_ARG="$HOME/.cf-cloud-gov-agent/$INST_NAME"
fi
case "$CF_HOME_ARG" in
  /*) ;;
  *) die "$EX_USAGE" "--cf-home must be an absolute path" ;;
esac
AGENT_CF_HOME="$(canon "$CF_HOME_ARG")"
printf '%s' "$AGENT_CF_HOME" | grep -Eq "$SAFE_PATH_RE" || die "$EX_REFUSED" "CF_HOME path '$AGENT_CF_HOME' has characters outside [A-Za-z0-9._/@+=,:-]; choose another with --cf-home"

CWD_REAL="$(pwd -P)"
case "$AGENT_CF_HOME/" in
  "$CWD_REAL"/*) die "$EX_REFUSED" "CF_HOME ($AGENT_CF_HOME) is inside the working directory; run from elsewhere or pass --cf-home outside it" ;;
esac
GIT_TOP="$(git -C "$CWD_REAL" rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$GIT_TOP" ]; then
  GIT_TOP="$(canon "$GIT_TOP")"
  case "$AGENT_CF_HOME/" in
    "$GIT_TOP"/*) die "$EX_REFUSED" "CF_HOME ($AGENT_CF_HOME) is inside the git work tree $GIT_TOP; choose a path outside any project" ;;
  esac
fi
if [ -n "${CF_HOME:-}" ] && [ "$(canon "$CF_HOME")" = "$AGENT_CF_HOME" ]; then
  die "$EX_REFUSED" "your own shell has CF_HOME set to the agent CF_HOME; unset it so your session and the service account's stay separate"
fi

CREATED_CFHOME=0
CREATED_KEY=0
AUTH_PENDING=0

cleanup() {
  local rc=$?
  trap - EXIT
  if [ "$AUTH_PENDING" = "1" ]; then
    # Authentication or the acq bind did not complete: undo only what THIS run created.
    if [ "$CREATED_CFHOME" = "1" ] && [ -f "${AGENT_CF_HOME:?}/$MARKER" ]; then
      rm -rf -- "${AGENT_CF_HOME:?}" >/dev/null 2>&1 || true
      printf 'setup-service-account: removed the CF_HOME this run created\n' >&2
    fi
    if [ "$CREATED_KEY" = "1" ]; then
      if "$CF_BIN" delete-service-key "$INST_NAME" "$KEY_NAME" -f >/dev/null 2>&1; then
        printf 'setup-service-account: deleted the service key this run created\n' >&2
      else
        printf 'setup-service-account: could not delete service key %s on %s; delete it yourself\n' "$KEY_NAME" "$INST_NAME" >&2
      fi
    fi
  fi
  exit "$rc"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

umask 077

CF_OUT=""
CF_RC=0
cf_capture() {
  CF_RC=0
  CF_OUT="$("$CF_BIN" "$@" 2>&1 </dev/null)" || CF_RC=$?
}

cf_home_capture() {
  CF_RC=0
  CF_OUT="$(CF_HOME="$AGENT_CF_HOME" "$CF_BIN" "$@" 2>&1 </dev/null)" || CF_RC=$?
}

scope_args=("$SANDBOX")
scope_desc="sandbox $SANDBOX"
if [ "$GLOBAL" = "1" ]; then
  scope_args=(-g)
  scope_desc="GLOBAL"
fi
KIT_SCRIPTS="$(cd "$(dirname "$0")" && pwd)"

fail_after_change() { die "$EX_FAILED" "$@"; }

print_policy_notes() {
  if [ "$PLAN" = "space-deployer" ]; then
    printf '  NOTE: space-deployer can change apps in this space. Use space-auditor unless the agent must deploy.\n'
  fi
  if [ "$GLOBAL" = "1" ]; then
    printf '  WARNING: --global binds this service account for EVERY sandbox: each sandbox request to %s is authorized as it\n' "$CLOUD_GOV_HOST"
    printf '           while the key is valid. Prefer --sandbox NAME.\n'
  fi
  printf '  Policy: whether an agent may act through a service account is for your ISSO to decide; no approval is implied.\n'
}

confirm_or_exit() {
  [ "$YES" = "1" ] && return 0
  if [ ! -t 0 ]; then
    die "$EX_DECLINED" "not confirmed: stdin is not a terminal; pass --yes to proceed non-interactively"
  fi
  printf 'Proceed? [y/N] '
  local ans=""
  read -r ans || ans=""
  case "$ans" in
    y | Y | yes | YES) ;;
    *) die "$EX_DECLINED" "not confirmed; nothing changed" ;;
  esac
}

# Reads a token from the private CF_HOME and gives it to `acq secret set` on stdin.
# acq alone chooses the backend and how the value is stored and injected; if acq
# fails, its own message is already on stderr and we stop (no other route is tried).
bind_token_via_acq() {
  local token
  token="$(CF_HOME="$AGENT_CF_HOME" "$CF_BIN" oauth-token 2>/dev/null </dev/null || true)"
  case "$token" in
    [Bb]earer\ ?*) ;;
    *) return 11 ;;
  esac
  case "$token" in *$'\n'*) return 12 ;; esac
  printf '%s\n' "$token" | acq secret set "${scope_args[@]}" cloud-gov --host "$CLOUD_GOV_HOST" --env CF_OAUTH_TOKEN || return 13
}

report_bind_failure() {
  case "$1" in
    11) fail_after_change "'cf oauth-token' gave no bearer token for the service-account session (refresh behavior is UNTESTED); nothing bound" ;;
    12) fail_after_change "'cf oauth-token' output was not a single line; nothing bound" ;;
    *) fail_after_change "acq secret set failed (acq's message is above); nothing is bound. This script does not try another route." ;;
  esac
}

print_next_steps() {
  local rerun_scope="--sandbox $SANDBOX"
  [ "$GLOBAL" = "1" ] && rerun_scope="--global"
  cat <<EOF2

Create (or recreate) the sandbox AFTER binding so it receives acq's placeholder.

Verify against the service-account session, not your own (scripts/verify needs
ACQ_BACKEND set to the backend you configured in acq):
  CLOUD_GOV_VERIFY_CF_HOME=$AGENT_CF_HOME RUN_ACQ=1 $KIT_SCRIPTS/verify

If the bound token expires, re-read a fresh one and rebind (no key change):
  $0 $rerun_scope --name $INST_NAME --cf-home $AGENT_CF_HOME --refresh
Rotate the service KEY (about every 90 days, when the password expires, or on suspicion):
  $0 $rerun_scope --plan $PLAN --name $INST_NAME --key-name $KEY_NAME --cf-home $AGENT_CF_HOME --rotate
Revoke:
  cf delete-service-key $INST_NAME $KEY_NAME -f
  remove the acq secret ('acq secret --help' lists the remove command)
  rm -rf -- $AGENT_CF_HOME
  (optional) cf delete-service $INST_NAME -f
EOF2
}

# ---- --refresh: re-read a token from the existing private CF_HOME and rebind ---------
if [ "$REFRESH" = "1" ]; then
  [ -d "$AGENT_CF_HOME" ] && [ -f "$AGENT_CF_HOME/$MARKER" ] || die "$EX_REFUSED" "$AGENT_CF_HOME is not a CF_HOME made by this script; run without --refresh first"
  mode_owner="$(python3 -c 'import os,stat,sys; s=os.stat(sys.argv[1]); print(oct(stat.S_IMODE(s.st_mode))[2:], int(s.st_uid == os.getuid()))' "$AGENT_CF_HOME")"
  [ "$mode_owner" = "700 1" ] || die "$EX_REFUSED" "$AGENT_CF_HOME must be mode 0700 and owned by you (found mode/owner-is-you: $mode_owner)"
  cf_home_capture api
  [ "$CF_RC" -eq 0 ] && [ "$(printf '%s\n' "$CF_OUT" | grep -c '^api endpoint:')" -eq 1 ] || die "$EX_REFUSED" "the private CF_HOME does not report a single api endpoint; run without --refresh"
  endpoint="$(printf '%s\n' "$CF_OUT" | sed -n 's/^api endpoint:[[:space:]]*//p' | sed 's/[[:space:]]*$//')"
  [ "$endpoint" = "$CLOUD_GOV_API" ] || die "$EX_REFUSED" "the private CF_HOME targets '$endpoint', not exactly $CLOUD_GOV_API; refusing"
  printf 'Plan (refresh; status: UNTESTED against the real services):\n'
  printf '  CF_HOME         %s (existing)\n' "$AGENT_CF_HOME"
  printf '  binding         acq secret set %s cloud-gov --host %s --env CF_OAUTH_TOKEN (token on stdin)\n' "${scope_args[*]}" "$CLOUD_GOV_HOST"
  print_policy_notes
  if [ "$DRY_RUN" = "1" ]; then
    printf '\nDry run: nothing was read or bound.\n'
    exit 0
  fi
  confirm_or_exit
  rc=0
  bind_token_via_acq || rc=$?
  [ "$rc" -eq 0 ] || report_bind_failure "$rc"
  printf 'rebound a fresh token from the service-account session through acq (%s)\n' "$scope_desc"
  print_next_steps
  exit 0
fi

# ---- the user's own session: exact endpoint, org and space ---------------------
cf_capture api
[ "$CF_RC" -eq 0 ] || die "$EX_REFUSED" "'cf api' failed; log in first: cf login -a $CLOUD_GOV_API --sso"
[ "$(printf '%s\n' "$CF_OUT" | grep -c '^api endpoint:')" -eq 1 ] || die "$EX_REFUSED" "'cf api' did not report exactly one api endpoint"
endpoint="$(printf '%s\n' "$CF_OUT" | sed -n 's/^api endpoint:[[:space:]]*//p' | sed 's/[[:space:]]*$//')"
[ "$endpoint" = "$CLOUD_GOV_API" ] || die "$EX_REFUSED" "cf targets '$endpoint', not exactly $CLOUD_GOV_API; refusing"

cf_capture target
[ "$CF_RC" -eq 0 ] || die "$EX_REFUSED" "'cf target' failed; log in and target an org and space (cf target -o ORG -s SPACE)"
TGT_ORG="$(printf '%s\n' "$CF_OUT" | sed -n 's/^org:[[:space:]]*//p' | sed 's/[[:space:]]*$//' | head -n 1)"
TGT_SPACE="$(printf '%s\n' "$CF_OUT" | sed -n 's/^space:[[:space:]]*//p' | sed 's/[[:space:]]*$//' | head -n 1)"
[ -n "$TGT_ORG" ] && [ -n "$TGT_SPACE" ] || die "$EX_REFUSED" "no org/space targeted; run: cf target -o ORG -s SPACE"

# ---- instance and key state (read-only) ----------------------------------------
INST_EXISTS=0
cf_capture service "$INST_NAME"
if [ "$CF_RC" -eq 0 ]; then
  have_offering="$(printf '%s\n' "$CF_OUT" | grep -E '^[[:space:]]*(offering|service):' | sed -E 's/^[^:]*:[[:space:]]*//; s/[[:space:]]*$//')"
  have_plan="$(printf '%s\n' "$CF_OUT" | grep -E '^[[:space:]]*plan:' | sed -E 's/^[^:]*:[[:space:]]*//; s/[[:space:]]*$//')"
  case "$have_offering$have_plan" in *$'\n'*) die "$EX_REFUSED" "'cf service $INST_NAME' output is ambiguous (repeated offering/plan lines); not changing anything" ;; esac
  [ -n "$have_offering" ] && [ -n "$have_plan" ] || die "$EX_REFUSED" "could not read offering/plan of existing instance '$INST_NAME' from 'cf service'; not changing anything"
  if [ "$have_offering" != "$SERVICE_OFFERING" ] || [ "$have_plan" != "$PLAN" ]; then
    die "$EX_REFUSED" "instance '$INST_NAME' exists as service '$have_offering' plan '$have_plan', not $SERVICE_OFFERING / $PLAN; choose another --name"
  fi
  INST_EXISTS=1
elif printf '%s\n' "$CF_OUT" | grep -qi 'not found'; then
  INST_EXISTS=0
else
  die "$EX_REFUSED" "'cf service $INST_NAME' failed for a reason other than 'not found'; not changing anything"
fi

KEY_EXISTS=0
if [ "$INST_EXISTS" = "1" ]; then
  cf_capture service-keys "$INST_NAME"
  [ "$CF_RC" -eq 0 ] || die "$EX_REFUSED" "'cf service-keys $INST_NAME' failed; not changing anything"
  if printf '%s\n' "$CF_OUT" | awk -v k="$KEY_NAME" '$1 == k { found = 1 } END { exit !found }'; then
    KEY_EXISTS=1
  fi
fi

# ---- CF_HOME state ---------------------------------------------------------------
CFHOME_EXISTS=0
if [ -e "$AGENT_CF_HOME" ] || [ -L "$AGENT_CF_HOME" ]; then
  [ -d "$AGENT_CF_HOME" ] || die "$EX_REFUSED" "$AGENT_CF_HOME exists and is not a directory"
  if [ -n "$(ls -A "$AGENT_CF_HOME" 2>/dev/null)" ]; then
    [ -f "$AGENT_CF_HOME/$MARKER" ] || die "$EX_REFUSED" "$AGENT_CF_HOME exists, is not empty, and was not created by this script; refusing to reuse it"
  fi
  mode_owner="$(python3 -c 'import os,stat,sys; s=os.stat(sys.argv[1]); print(oct(stat.S_IMODE(s.st_mode))[2:], int(s.st_uid == os.getuid()))' "$AGENT_CF_HOME")"
  [ "$mode_owner" = "700 1" ] || die "$EX_REFUSED" "$AGENT_CF_HOME must be mode 0700 and owned by you (found mode/owner-is-you: $mode_owner)"
  CFHOME_EXISTS=1
fi

# ---- plan --------------------------------------------------------------------------
if [ "$KEY_EXISTS" = "1" ] && [ "$ROTATE" = "0" ]; then
  key_action="reuse existing key (no new key; pass --rotate to replace it)"
elif [ "$KEY_EXISTS" = "1" ]; then
  key_action="DELETE key $KEY_NAME, then create a new one"
else
  key_action="create key $KEY_NAME"
fi
if [ "$INST_EXISTS" = "1" ]; then inst_action="reuse existing instance"; else inst_action="create instance"; fi
bind_desc="acq secret set ${scope_args[*]} cloud-gov --host $CLOUD_GOV_HOST --env CF_OAUTH_TOKEN (token on stdin)"

printf 'Plan (service account for cloud.gov, status: UNTESTED against the real services):\n'
printf '  target          org %s / space %s (%s)\n' "$TGT_ORG" "$TGT_SPACE" "$CLOUD_GOV_API"
printf '  instance        %s: %s (%s / %s)\n' "$INST_NAME" "$inst_action" "$SERVICE_OFFERING" "$PLAN"
printf '  service key     %s\n' "$key_action"
printf '  CF_HOME         %s (%s)\n' "$AGENT_CF_HOME" "$([ "$CFHOME_EXISTS" = 1 ] && echo 'exists, reused' || echo 'will be created, mode 0700')"
printf '  binding         %s\n' "$bind_desc"
print_policy_notes

if [ "$DRY_RUN" = "1" ]; then
  printf '\nDry run: nothing was created, authenticated, or bound.\n'
  exit 0
fi

confirm_or_exit

# ---- 1. instance ---------------------------------------------------------------------
if [ "$INST_EXISTS" = "0" ]; then
  cf_capture create-service "$SERVICE_OFFERING" "$PLAN" "$INST_NAME"
  [ "$CF_RC" -eq 0 ] || fail_after_change "cf create-service failed (exit $CF_RC); nothing else was changed"
  printf 'created instance %s\n' "$INST_NAME"
fi

# ---- 2. key ----------------------------------------------------------------------------
if [ "$KEY_EXISTS" = "1" ] && [ "$ROTATE" = "1" ]; then
  cf_capture delete-service-key "$INST_NAME" "$KEY_NAME" -f
  [ "$CF_RC" -eq 0 ] || fail_after_change "cf delete-service-key failed (exit $CF_RC); the old key is still in place"
  printf 'deleted old key %s\n' "$KEY_NAME"
  KEY_EXISTS=0
fi
if [ "$KEY_EXISTS" = "0" ]; then
  cf_capture create-service-key "$INST_NAME" "$KEY_NAME"
  [ "$CF_RC" -eq 0 ] || fail_after_change "cf create-service-key failed (exit $CF_RC); instance $INST_NAME exists with no key (re-run, or delete it with: cf delete-service $INST_NAME -f)"
  CREATED_KEY=1
  printf 'created key %s\n' "$KEY_NAME"
fi

# From here a failure must undo what this run created (key, CF_HOME).
AUTH_PENDING=1

# ---- 3. private CF_HOME --------------------------------------------------------------------
if [ "$CFHOME_EXISTS" = "0" ]; then
  mkdir -p -- "$AGENT_CF_HOME"
  CREATED_CFHOME=1
  chmod 700 "$AGENT_CF_HOME"
  : >"$AGENT_CF_HOME/$MARKER"
elif [ ! -f "$AGENT_CF_HOME/$MARKER" ]; then
  # An existing EMPTY directory (checked above): adopt it so re-runs recognize it.
  # CREATED_CFHOME stays 0, so cleanup never removes a directory we did not make.
  : >"$AGENT_CF_HOME/$MARKER"
fi

# ---- 4. authenticate the service account into that CF_HOME ----------------------------------
# The python3 child reads `cf service-key` output, parses the JSON, and hands the
# credentials to `cf auth` only through that child process's environment. Nothing
# is echoed; the child prints one status word.
read -r -d '' PY_AUTH <<'PY' || true
import json, os, subprocess, sys

try:
    cf, inst, key, home, api = sys.argv[1:6]
    user_env = {k: v for k, v in os.environ.items() if k not in ("CF_TRACE", "CF_USERNAME", "CF_PASSWORD")}

    def run(args, env):
        return subprocess.run([cf] + args, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True)

    r = run(["service-key", inst, key], user_env)
    if r.returncode != 0:
        print("fail:key-read")
        sys.exit(1)
    out = r.stdout
    i = out.find("{")
    if i < 0:
        print("fail:key-shape")
        sys.exit(1)
    try:
        doc, _ = json.JSONDecoder().raw_decode(out[i:])
    except ValueError:
        print("fail:key-shape")
        sys.exit(1)
    if isinstance(doc, dict) and isinstance(doc.get("credentials"), dict):
        doc = doc["credentials"]
    user = doc.get("username") if isinstance(doc, dict) else None
    pw = doc.get("password") if isinstance(doc, dict) else None
    if not (isinstance(user, str) and user and isinstance(pw, str) and pw):
        print("fail:key-shape")
        sys.exit(1)
    del out, r, doc

    home_env = dict(user_env)
    home_env["CF_HOME"] = home
    if run(["api", api], home_env).returncode != 0:
        print("fail:api")
        sys.exit(1)
    home_env["CF_USERNAME"] = user
    home_env["CF_PASSWORD"] = pw
    if run(["auth"], home_env).returncode != 0:
        print("fail:auth")
        sys.exit(1)
    print("ok")
except SystemExit:
    raise
except Exception:
    print("fail:internal")
    sys.exit(1)
PY

AUTH_RESULT="$(PYTHONDONTWRITEBYTECODE=1 python3 -c "$PY_AUTH" "$CF_BIN" "$INST_NAME" "$KEY_NAME" "$AGENT_CF_HOME" "$CLOUD_GOV_API" 2>/dev/null </dev/null)" || AUTH_RESULT="${AUTH_RESULT:-fail:internal}"
case "$AUTH_RESULT" in
  ok) ;;
  fail:key-read) fail_after_change "could not read service key $KEY_NAME on $INST_NAME with 'cf service-key'; nothing bound" ;;
  fail:key-shape) fail_after_change "'cf service-key' output was not the expected JSON with username and password; nothing bound (this shape is UNTESTED)" ;;
  fail:api) fail_after_change "'cf api $CLOUD_GOV_API' failed in the private CF_HOME; nothing bound" ;;
  fail:auth) fail_after_change "'cf auth' was rejected or does not read CF_USERNAME/CF_PASSWORD from the environment (UNTESTED); nothing bound" ;;
  *) fail_after_change "service-account authentication failed ($AUTH_RESULT); nothing bound" ;;
esac
printf 'authenticated the service account into %s\n' "$AGENT_CF_HOME"

# ---- 5. token, then hand it to acq (acq decides everything about the backend) -------------------
rc=0
bind_token_via_acq || rc=$?
[ "$rc" -eq 0 ] || report_bind_failure "$rc"
AUTH_PENDING=0
printf 'bound a token from the service-account session through acq (%s)\n' "$scope_desc"

# ---- 6. summary (no secrets) ---------------------------------------------------------------------
printf '\nDone. Created or reused: instance %s (%s), key %s, CF_HOME %s.\n' "$INST_NAME" "$PLAN" "$KEY_NAME" "$AGENT_CF_HOME"
print_next_steps
