#!/usr/bin/env bash
#
# verify — host-side, end-to-end check for the team-kit TEMPLATE, and for any
# copy of it. Backend-neutral: only `acq` verbs (kit validate, create, exec,
# rm), so it runs the same on sbx and msb.
#
# It creates a throwaway sandbox through `acq`, which applies its pinned
# built-in bundle (zscaler-ca-certificate, usai-provider,
# agentic-coding-playbook, git-ssh-sign) and then, via ACQ_EXTRA_KITS, a
# generated LOWER fixture kit followed by this kit. It then asserts:
#   1. the global layer is intact (USAi merged into OpenCode's global config);
#   2. every live extension-point value in spec.yaml landed, and the OpenCode
#      that sandbox shells run is 1.x (2.x ignores `instructions`);
#   3. the lower fixture itself was applied (its own env var, file, and
#      startup command landed), so the next checks are not vacuous;
#   4. the composition-table rows it can observe (environment, files[],
#      commands[], caps.network.allow; see the pattern doc) hold against the
#      lower fixture.
# Extend the TEAM-SPECIFIC section as your kit grows: one assertion per
# mechanism the kit adds.
#
# The sandbox is named "<kit>-verify-<pid>" and removed at the end (and on
# interrupt). Nothing here prints secret values.
#
# Usage (from anywhere):
#   path/to/team-kit/scripts/verify
#   KEEP=1 …/scripts/verify                 # keep the sandbox + work dir
#   ACQ_DIR=/path/to/quickstart …/verify    # acq not on PATH: use this checkout
#   SKIP_NETWORK=1 …/verify                 # skip the egress probes (offline host)
#
# set -e is omitted on purpose: accumulate pass/fail rather than abort.

set -uo pipefail

KIT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
KIT_NAME="$(basename "$KIT_DIR")"
SBX_NAME="${KIT_NAME}-verify-$$"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/${KIT_NAME}-verify.XXXXXX")"
WORKSPACE="$WORK/workspace"
LOWER_KIT="$WORK/lower-kit"
CREATE_LOG="$WORK/acq-create.log"
KEEP="${KEEP:-0}"
SKIP_NETWORK="${SKIP_NETWORK:-0}"

# acq: on PATH, or from an agentic-coding-quickstart checkout named by ACQ_DIR.
if [ -n "${ACQ_DIR:-}" ]; then ACQ="$ACQ_DIR/acq"; else ACQ="$(command -v acq || true)"; fi

# Values this template ships (mirror spec.yaml; update both when you replace
# one). The lower fixture sets the SAME keys to different values so the
# assertions distinguish "landed" from "landed because nothing competed".
TEAM_CONFIG=/home/agent/team-config/opencode.jsonc
TEAM_CONVENTIONS=/home/agent/team-config/team-conventions.md
TEAM_EGRESS_HOST=example.org
LOWER_CONFIG=/home/agent/lower-fixture/opencode.jsonc
LOWER_MARKER_FILE=/home/agent/lower-fixture/applied
LOWER_MARKER_CMD=/home/agent/lower-fixture/startup-ran
LOWER_EGRESS_HOST=example.com
# Allowed by no kit: the egress probe's negative control.
UNLISTED_EGRESS_HOST=example.net

pass=0
fail=0
skipped=0
ok()   { printf '  \033[32mPASS\033[0m %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }
skip() { printf '  \033[2mSKIP\033[0m %s\n' "$1"; skipped=$((skipped+1)); }
info() { printf '\n\033[1m%s\033[0m\n' "$1"; }

cleanup() {
  if [ "$KEEP" = "1" ]; then
    printf '\nKEEP=1 set; leaving sandbox %s and %s in place.\n' "$SBX_NAME" "$WORK" >&2
    return
  fi
  [ -n "$ACQ" ] && "$ACQ" rm "$SBX_NAME" </dev/null >/dev/null 2>&1 || true
  rm -rf "$WORK" >/dev/null 2>&1 || true
}
trap cleanup EXIT
# On a signal, exit non-zero (the EXIT trap then cleans up) rather than falling
# through: the probes below swallow errors, so continuing would keep "testing"
# a removed sandbox and print a cascade of misleading FAILs.
trap 'exit 130' INT TERM

# Run a command in the sandbox; stderr dropped, failures collapse to empty
# output. Pair every negative assertion with a positive one that would fail
# loudly, or a broken exec passes it vacuously.
in_sbx() { "$ACQ" exec "$SBX_NAME" -- sh -c "$1" </dev/null 2>/dev/null || true; }

# HTTP status code seen from the sandbox for https://HOST/ ("000" = no
# connection). msb denies with 000, sbx's proxy with its own 403 page; the
# unlisted control host confirms one of those is the deny answer.
probe_host() { in_sbx "curl -sS -o /dev/null -m 20 -w '%{http_code}' 'https://$1/' 2>/dev/null"; }

info "0. Preconditions"
if [ -z "$ACQ" ] || [ ! -x "$ACQ" ]; then
  echo "  acq not found. Put acq on PATH, or set ACQ_DIR to an agentic-coding-quickstart checkout." >&2
  exit 1
fi
# `acq kit validate` exists only in an acq with the kit-translate layer (acq
# v2.0.0+). Checked through acq itself: PATH usually holds a symlink into the
# quickstart clone, so a path-relative file check would look in the wrong place.
kit_usage="$("$ACQ" kit </dev/null 2>&1 || true)"
case "$kit_usage" in
  *validate*) ;;
  *) echo "  $ACQ has no 'kit validate' verb — update the quickstart checkout (git pull)." >&2; exit 1 ;;
esac
"$ACQ" version 2>/dev/null | sed 's/^/  /'
if [ -f "$KIT_DIR/spec.yaml" ]; then
  ok "kit spec.yaml present"
else
  bad "spec.yaml missing"; exit 1
fi
# Both paths go into ACQ_EXTRA_KITS, which is whitespace-separated.
case "$WORK" in
  *[[:space:]]*) bad "work dir path contains whitespace; ACQ_EXTRA_KITS is whitespace-separated (set TMPDIR)"; exit 1 ;;
esac
case "$KIT_DIR" in
  *[[:space:]]*) bad "kit path contains whitespace; ACQ_EXTRA_KITS is whitespace-separated (move the kit)"; exit 1 ;;
esac

info "1. Kit validates (hybrid/v1)"
if "$ACQ" kit validate "$KIT_DIR" >/dev/null 2>&1; then
  ok "kit validates"
else
  bad "kit failed validation — run: $ACQ kit validate $KIT_DIR"
fi

info "2. Generate the lower fixture kit"
# Sits BELOW the kit under test in ACQ_EXTRA_KITS and competes on every
# composed field: same env NAME, same file path, a command that sets the
# opposite value, and an egress host of its own. It also leaves its own
# uncontested marks (env var, file, startup artifact) so section 6 can prove
# the fixture was applied at all; otherwise a skipped fixture would make every
# "last wins" check pass trivially.
mkdir -p "$LOWER_KIT/files/home/team-config" "$LOWER_KIT/files/home/lower-fixture"
printf 'lower-fixture: this content must be replaced by the kit under test\n' \
  > "$LOWER_KIT/files/home/team-config/team-conventions.md"
printf 'lower-fixture: applied\n' > "$LOWER_KIT/files/home/lower-fixture/applied"
printf '# lower fixture\n' > "$LOWER_KIT/README.md"
cat > "$LOWER_KIT/spec.yaml" <<EOF
schemaVersion: "hybrid/v1"
kind: mixin
name: ${KIT_NAME}-verify-lower
displayName: ${KIT_NAME} verify (lower fixture)
description: >
  Generated by scripts/verify. Applied just below the kit under test so the
  composition rules (union / last-wins / append) can be asserted.
caps:
  network:
    allow:
      - ${LOWER_EGRESS_HOST}
files:
  - path: ${TEAM_CONVENTIONS}
    mode: "0644"
    source: files/home/team-config/team-conventions.md
  - path: ${LOWER_MARKER_FILE}
    mode: "0644"
    source: files/home/lower-fixture/applied
commands:
  - phase: startup
    user: "1000"
    description: Set the value the kit under test must override, and record that it ran
    command:
      - sh
      - -c
      - git config --global push.autoSetupRemote false && touch ${LOWER_MARKER_CMD}
environment:
  OPENCODE_CONFIG: ${LOWER_CONFIG}
  LOWER_FIXTURE_APPLIED: "1"
EOF
if "$ACQ" kit validate "$LOWER_KIT" >/dev/null 2>&1; then
  ok "lower fixture kit validates"
else
  bad "lower fixture kit failed validation"; exit 1
fi

info "3. Create a sandbox through acq (built-in bundle + lower fixture + this kit)"
mkdir -p "$WORKSPACE" && git init -q "$WORKSPACE"
echo "  creating $SBX_NAME (workspace $WORKSPACE)..."
ACQ_EXTRA_KITS="$LOWER_KIT $KIT_DIR" ACQ_UPDATE_CHECK=0 \
  "$ACQ" create opencode --name "$SBX_NAME" "$WORKSPACE" </dev/null >"$CREATE_LOG" 2>&1
rc=$?
if [ "$rc" -eq 0 ]; then
  ok "sandbox created (kits via ACQ_EXTRA_KITS)"
else
  bad "acq create failed (exit $rc)"
  sed 's/^/  | /' "$CREATE_LOG" >&2
  exit 1
fi
# Startup steps can run for a while after create returns. Poll for the
# fixture's startup marker AND this kit's git key (the LAST startup command),
# rather than an env var: environment is materialized by the backend and can
# be visible before any startup command has run, so it fences nothing. If you
# replace this kit's git step, poll for your last step's artifact instead.
printf '  waiting for startup steps to settle'
settled=0
for _ in $(seq 1 120); do
  [ "$(in_sbx "test -f $LOWER_MARKER_CMD && git config --global push.autoSetupRemote 2>/dev/null")" = "true" ] && { settled=1; break; }
  printf '.'; sleep 1
done
printf '\n'
[ "$settled" = 1 ] || echo "  note: startup did not settle within 120s; later checks may run before it finished. If you replaced the git step, update this poll." >&2

info "4. Global layer intact"
if [ "$(in_sbx '{ [ -f "$HOME/.config/opencode/opencode.json" ] || [ -f "$HOME/.config/opencode/opencode.jsonc" ]; } && echo y')" = "y" ]; then
  ok "USAi merged into OpenCode's global config"
else
  bad "global OpenCode config missing (USAi merge did not run?)"
fi
eff="$("$ACQ" exec "$SBX_NAME" -- sh -c 'opencode debug config' </dev/null 2>"$WORK/debug-config.err")" \
  || sed 's/^/    stderr| /' "$WORK/debug-config.err" >&2
if printf '%s' "$eff" | grep -q '"usai"'; then
  ok "USAi provider present in the effective config"
else
  bad "USAi provider missing from the effective config"
fi

info "5. Live values landed"
# OPENCODE_CONFIG and the startup command are asserted once, in section 7,
# where the fixture's competing values make the check meaningful.
if [ "$(in_sbx "test -f $TEAM_CONFIG && echo y")" = "y" ]; then
  ok "team config file present"
else
  bad "team config file missing"
fi
if [ "$(in_sbx "test -f $TEAM_CONVENTIONS && echo y")" = "y" ]; then
  ok "team conventions file present"
else
  bad "team conventions file missing"
fi
if printf '%s' "$eff" | grep -q 'team-conventions.md'; then
  ok "team conventions registered in the effective config instructions"
else
  bad "team-conventions.md missing from the effective config instructions"
fi
# Registered is not read: OpenCode 2.x accepts `instructions` but never loads
# the files it lists, so the conventions would silently not reach the agent.
# Check the OpenCode that sandbox shells resolve on PATH: an image that bakes
# 1.x puts it ahead of the agent kit's 2.x, while an image with no OpenCode of
# its own (such as sandbox-templates:shell-docker) runs only 2.x, and this
# fails. Relax it once a 2.x release loads `instructions` files.
oc_version="$(in_sbx 'opencode --version 2>/dev/null' | tail -n1)"
oc_version="${oc_version#opencode }"
oc_major="$(printf '%s\n' "$oc_version" | sed -n 's/^[^0-9]*\([0-9][0-9]*\)\..*/\1/p' | head -n1)"
case "$oc_major" in
  "") bad "could not read the OpenCode version in the sandbox ('${oc_version:-no output}')" ;;
  1) ok "OpenCode $oc_version loads instructions files" ;;
  *) bad "OpenCode $oc_version ignores the instructions field: team conventions will not reach the agent (pattern doc, Check against your acq)" ;;
esac
# The file, not the directory: the global playbook kit creates
# ~/.agents/skills itself, so a directory check would pass without this kit.
# Once you replace the placeholder with real skills, this skips; add a check
# per skill in the TEAM-SPECIFIC section.
if grep -qF 'files/home/.agents/skills/.gitkeep' "$KIT_DIR/spec.yaml"; then
  if [ "$(in_sbx 'test -s "$HOME/.agents/skills/.gitkeep" && echo y')" = "y" ]; then
    ok "team skills placeholder present"
  else
    bad "team skills placeholder missing"
  fi
else
  skip "team skills placeholder (removed from spec.yaml)"
fi

info "6. Lower fixture applied"
# Without these, the composition checks below could pass with the fixture
# silently skipped (e.g. a failed drop aborting its apply on msb).
if [ "$(in_sbx 'printf "%s" "${LOWER_FIXTURE_APPLIED:-}"')" = "1" ]; then
  ok "fixture environment applied (LOWER_FIXTURE_APPLIED=1)"
else
  bad "fixture environment not applied"
fi
if [ "$(in_sbx "test -s $LOWER_MARKER_FILE && echo y")" = "y" ]; then
  ok "fixture files[] applied"
else
  bad "fixture files[] not applied"
fi
if [ "$(in_sbx "test -f $LOWER_MARKER_CMD && echo y")" = "y" ]; then
  ok "fixture startup command ran"
else
  bad "fixture startup command did not run"
fi

info "7. Composition rules (docs/scope-layers.md), against the lower fixture"
# environment: last wins by name. The fixture set OPENCODE_CONFIG first.
cfg="$(in_sbx 'printf "%s" "${OPENCODE_CONFIG:-}"')"
if [ "$cfg" = "$TEAM_CONFIG" ]; then
  ok "environment: last wins (this kit's OPENCODE_CONFIG replaced the fixture's)"
else
  bad "environment: fixture's OPENCODE_CONFIG survived ('${cfg:-<unset>}')"
fi
# files[]: last wins by path. Both kits drop team-conventions.md.
guest_sum="$(in_sbx "cksum < $TEAM_CONVENTIONS")"
kit_sum="$(cksum < "$KIT_DIR/files/home/team-config/team-conventions.md")"
if [ -n "$guest_sum" ] && [ "$guest_sum" = "$kit_sum" ]; then
  ok "files[]: last wins by path (this kit's team-conventions.md replaced the fixture's)"
elif [ -z "$guest_sum" ]; then
  bad "files[]: team-conventions.md missing from the guest (neither kit's drop landed)"
elif [ "$(in_sbx "grep -c lower-fixture $TEAM_CONVENTIONS")" = "1" ]; then
  bad "files[]: the fixture's team-conventions.md survived"
else
  bad "files[]: team-conventions.md content matches neither kit"
fi
# commands[]: append in kit order. The fixture set push.autoSetupRemote=false
# first; this kit's later command must have set it to true.
if [ "$(in_sbx 'git config --global push.autoSetupRemote 2>/dev/null')" = "true" ]; then
  ok "commands[]: append in order (this kit's startup command ran after the fixture's)"
else
  bad "commands[]: fixture's command ran last, or this kit's did not run"
fi
# caps.network.allow: union. The backends deny with 000 (no connection, msb)
# or 403 (proxy, sbx). A host listed by no kit must get one of those (the
# negative control); each kit's host must get neither. The kit's host must be
# one the global layer does not already allow, or this proves nothing about
# the kit's own entry, and it must answer at / with neither code (a host that
# answers 403 to an anonymous request reads as denied; pick another).
if [ "$SKIP_NETWORK" = "1" ]; then
  skip "caps.network.allow union (SKIP_NETWORK=1)"
else
  code_denied="$(probe_host "$UNLISTED_EGRESS_HOST")"
  case "$code_denied" in
    000|403) ok "caps.network.allow: unlisted control host denied ($UNLISTED_EGRESS_HOST -> $code_denied)" ;;
    "") bad "caps.network.allow: probe of the unlisted control host failed (no answer from acq exec)" ;;
    *) bad "caps.network.allow: unlisted control host answered $code_denied, not a deny code (000/403): something admits it, so the union cannot be observed" ;;
  esac
  if [ "$code_denied" = 000 ] || [ "$code_denied" = 403 ]; then
    for side in fixture kit; do
      if [ "$side" = fixture ]; then host="$LOWER_EGRESS_HOST"; else host="$TEAM_EGRESS_HOST"; fi
      code="$(probe_host "$host")"
      case "$code" in
        000|403|"") bad "caps.network.allow: $side's host denied ($host -> ${code:-none}); union broken, or the host is offline" ;;
        *) ok "caps.network.allow: $side's host admitted ($host -> $code)" ;;
      esac
    done
  fi
fi

info "8. TEAM-SPECIFIC checks (extend as your kit grows)"
# One assertion per mechanism your kit adds: an env var, a shipped file, a
# startup command's effect, an entry in the effective agent config, a skill...
skip "no team-specific checks yet"

info "Summary"
printf '  %d passed, %d failed, %d skipped\n' "$pass" "$fail" "$skipped"
if [ "$fail" -eq 0 ]; then
  printf '  \033[32mAll checks passed.\033[0m\n'
else
  printf '  \033[31mSome checks failed — see notes above.\033[0m\n'
fi

[ "$fail" -eq 0 ]
