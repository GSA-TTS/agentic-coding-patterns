#!/usr/bin/env bash
#
# verify — host-side, end-to-end check for the personal-kit TEMPLATE, and for
# any copy of it. Backend-neutral: only `acq` verbs (kit validate, create,
# exec, rm), so it runs the same on sbx and msb.
#
# It proves the three-layer stack. It creates a throwaway sandbox through
# `acq`, which applies its pinned built-in bundle (zscaler-ca-certificate,
# usai-provider, agentic-coding-playbook, git-ssh-sign) and then, via
# ACQ_EXTRA_KITS, the TEAM kit followed by this kit. It then asserts:
#   1. the global layer is intact (USAi merged into OpenCode's global config);
#   2. the team layer is intact under this kit (its env var, conventions,
#      startup command, and egress host all survive);
#   3. every live extension-point value in spec.yaml landed (so both kits'
#      environment and files[] coexist), a bash login shell sources the shell
#      drop-in exactly once, and a scripted bash -lc still runs;
#   4. caps.network.allow is the union of both kits' hosts.
# The per-field rules themselves (last wins, append order) are asserted by
# the team-kit template's verify against a competing fixture.
# Extend the PERSONAL section as your kit grows: one assertion per mechanism.
#
# The team kit defaults to the team-kit template next to this one. Point
# TEAM_KIT at your team's real kit and set the TEAM_* variables to what it
# ships (each defaults to the team-kit template's value). If your team kit
# allows example.com, set UNLISTED_EGRESS_HOST to a host neither kit allows.
# Each kit's egress host must answer at / with a code other than the
# backend's deny response (000 on msb, 403 on sbx), or it reads as denied.
# The personal host must also be one the team kit does NOT allow; otherwise
# the check passes on the team's entry and proves nothing about yours.
#
# Usage (from anywhere):
#   path/to/personal-kit/scripts/verify
#   TEAM_KIT=/path/to/team-kit …/verify     # stack on your team's kit
#   TEAM_CONFIG=… TEAM_EGRESS_HOST=… …/verify   # that kit's values (see below)
#   PERSONAL_EGRESS_HOST=… …/verify         # your own egress host, once replaced
#   KEEP=1 …/verify                         # keep the sandbox + work dir
#   ACQ_DIR=/path/to/quickstart …/verify    # acq not on PATH: use this checkout
#   SKIP_NETWORK=1 …/verify                 # skip the egress probes (offline host)
#
# set -e is omitted on purpose: accumulate pass/fail rather than abort.

set -uo pipefail

KIT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
KIT_NAME="$(basename "$KIT_DIR")"
TEAM_KIT="${TEAM_KIT:-$(dirname "$KIT_DIR")/team-kit}"
SBX_NAME="${KIT_NAME}-verify-$$"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/${KIT_NAME}-verify.XXXXXX")"
WORKSPACE="$WORK/workspace"
CREATE_LOG="$WORK/acq-create.log"
KEEP="${KEEP:-0}"
SKIP_NETWORK="${SKIP_NETWORK:-0}"

# acq: on PATH, or from an agentic-coding-quickstart checkout named by ACQ_DIR.
if [ -n "${ACQ_DIR:-}" ]; then ACQ="$ACQ_DIR/acq"; else ACQ="$(command -v acq || true)"; fi

# Values this kit ships (mirror spec.yaml; update both when you replace one).
PERSONAL_TUI=/home/agent/personal/tui.jsonc
PERSONAL_DROPIN=/home/agent/.rc.d/50-example.sh
PERSONAL_ALIAS=gst
PERSONAL_GIT_KEY=alias.st
PERSONAL_GIT_VALUE=status
PERSONAL_EGRESS_HOST="${PERSONAL_EGRESS_HOST-example.net}"
# Values the team kit ships; override them for your team's kit, or set one to
# empty to skip its check when the team kit has no such thing. Defaults are
# the team-kit template's.
TEAM_CONFIG="${TEAM_CONFIG-/home/agent/team-config/opencode.jsonc}"
TEAM_CONVENTIONS="${TEAM_CONVENTIONS-team-conventions.md}"
TEAM_GIT_KEY="${TEAM_GIT_KEY-push.autoSetupRemote}"
TEAM_GIT_VALUE="${TEAM_GIT_VALUE-true}"
TEAM_EGRESS_HOST="${TEAM_EGRESS_HOST-example.org}"
# Allowed by neither kit: the egress probe's negative control.
UNLISTED_EGRESS_HOST="${UNLISTED_EGRESS_HOST:-example.com}"

pass=0
fail=0
skipped=0
ok()   { printf '  \033[32mPASS\033[0m %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }
skip() { printf '  \033[2mSKIP\033[0m %s\n' "$1"; skipped=$((skipped+1)); }
info() { printf '\n\033[1m%s\033[0m\n' "$1"; }

cleanup() {
  if [ "$KEEP" = "1" ]; then
    printf '\nKEEP=1 set; leaving sandbox %s and %s in place.\n' "$SBX_NAME" "$WORK" >&2
    return
  fi
  [ -n "$ACQ" ] && "$ACQ" rm "$SBX_NAME" </dev/null >/dev/null 2>&1 || true
  rm -rf "$WORK" >/dev/null 2>&1 || true
}
trap cleanup EXIT
# On a signal, exit non-zero (the EXIT trap then cleans up) rather than falling
# through: the probes below swallow errors, so continuing would keep "testing"
# a removed sandbox and print a cascade of misleading FAILs.
trap 'exit 130' INT TERM

# Run a command in the sandbox; stderr dropped, failures collapse to empty
# output. Pair every negative assertion with a positive one that would fail
# loudly, or a broken exec passes it vacuously.
in_sbx() { "$ACQ" exec "$SBX_NAME" -- sh -c "$1" </dev/null 2>/dev/null || true; }

# HTTP status code seen from the sandbox for https://HOST/ ("000" = no
# connection). msb denies with 000, sbx's proxy with its own 403 page; the
# unlisted control host confirms one of those is the deny answer.
probe_host() { in_sbx "curl -sS -o /dev/null -m 20 -w '%{http_code}' 'https://$1/' 2>/dev/null"; }

# True if SPEC has HOST as an uncommented list item, exactly (optionally
# quoted, optionally followed by a comment). A plain substring match would
# also hit commented examples and longer hosts that start with HOST.
spec_lists_host() {
  _re="$(printf '%s' "$2" | sed 's/[.[\*^$+?(){}|/]/\\&/g')"
  grep -qE "^[[:space:]]*-[[:space:]]+[\"']?${_re}[\"']?([[:space:]]|$)" "$1"
}

info "0. Preconditions"
if [ -z "$ACQ" ] || [ ! -x "$ACQ" ]; then
  echo "  acq not found. Put acq on PATH, or set ACQ_DIR to an agentic-coding-quickstart checkout." >&2
  exit 1
fi
# `acq kit validate` exists only in an acq with the kit-translate layer (acq
# v2.0.0+). Checked through acq itself: PATH usually holds a symlink into the
# quickstart clone, so a path-relative file check would look in the wrong place.
kit_usage="$("$ACQ" kit </dev/null 2>&1 || true)"
case "$kit_usage" in
  *validate*) ;;
  *) echo "  $ACQ has no 'kit validate' verb — update the quickstart checkout (git pull)." >&2; exit 1 ;;
esac
"$ACQ" version 2>/dev/null | sed 's/^/  /'
if [ -f "$KIT_DIR/spec.yaml" ]; then
  ok "kit spec.yaml present"
else
  bad "spec.yaml missing"; exit 1
fi
if [ -f "$TEAM_KIT/spec.yaml" ]; then
  ok "team kit found ($TEAM_KIT)"
else
  bad "team kit not found at $TEAM_KIT (set TEAM_KIT)"; exit 1
fi
# Both kit paths go into ACQ_EXTRA_KITS, which is whitespace-separated.
case "$TEAM_KIT$KIT_DIR" in
  *[[:space:]]*) bad "a kit path contains whitespace; ACQ_EXTRA_KITS is whitespace-separated (move the kit)"; exit 1 ;;
esac

info "1. Kits validate (hybrid/v1)"
for k in "$TEAM_KIT" "$KIT_DIR"; do
  if "$ACQ" kit validate "$k" >/dev/null 2>&1; then
    ok "$(basename "$k") validates"
  else
    bad "$(basename "$k") failed validation — run: $ACQ kit validate $k"
  fi
done

info "2. Create a sandbox through acq (built-in bundle + team kit + this kit)"
mkdir -p "$WORKSPACE" && git init -q "$WORKSPACE"
echo "  creating $SBX_NAME (workspace $WORKSPACE)..."
ACQ_EXTRA_KITS="$TEAM_KIT $KIT_DIR" ACQ_UPDATE_CHECK=0 \
  "$ACQ" create opencode --name "$SBX_NAME" "$WORKSPACE" </dev/null >"$CREATE_LOG" 2>&1
rc=$?
if [ "$rc" -eq 0 ]; then
  ok "sandbox created (kits via ACQ_EXTRA_KITS)"
else
  bad "acq create failed (exit $rc)"
  sed 's/^/  | /' "$CREATE_LOG" >&2
  exit 1
fi
# Startup steps can run for a while after create returns. Poll for the LAST
# startup command's artifact, this kit's git key: commands append in kit
# order, so once it is set every earlier step has run. If you add or
# uncomment a step AFTER it in spec.yaml (the terminfo or Nix examples), poll
# for that step's artifact instead, or its checks may run before it finishes.
printf '  waiting for startup steps to settle'
settled=0
for _ in $(seq 1 120); do
  [ "$(in_sbx "git config --global $PERSONAL_GIT_KEY 2>/dev/null")" = "$PERSONAL_GIT_VALUE" ] && { settled=1; break; }
  printf '.'; sleep 1
done
printf '\n'
[ "$settled" = 1 ] || echo "  note: $PERSONAL_GIT_KEY never became '$PERSONAL_GIT_VALUE' within 120s; later checks may run before startup finished. If you replaced that step, update PERSONAL_GIT_KEY/PERSONAL_GIT_VALUE." >&2

info "3. Global layer intact"
eff="$("$ACQ" exec "$SBX_NAME" -- sh -c 'opencode debug config' </dev/null 2>"$WORK/debug-config.err")" \
  || sed 's/^/    stderr| /' "$WORK/debug-config.err" >&2
if printf '%s' "$eff" | grep -q '"usai"'; then
  ok "USAi provider present in the effective config"
else
  bad "USAi provider missing from the effective config"
fi

info "4. Team layer intact under this kit"
if [ -n "$TEAM_CONFIG" ]; then
  cfg="$(in_sbx 'printf "%s" "${OPENCODE_CONFIG:-}"')"
  if [ "$cfg" = "$TEAM_CONFIG" ]; then
    ok "team OPENCODE_CONFIG survives ($cfg)"
  else
    bad "team OPENCODE_CONFIG unexpected: '${cfg:-<unset>}' (shadowed by this kit, or the team kit did not apply)"
  fi
else skip "team OPENCODE_CONFIG (TEAM_CONFIG empty)"; fi
if [ -n "$TEAM_CONVENTIONS" ]; then
  if printf '%s' "$eff" | grep -qF "$TEAM_CONVENTIONS"; then
    ok "team conventions still in the effective config instructions"
  else
    bad "$TEAM_CONVENTIONS missing from the effective config instructions"
  fi
else skip "team conventions (TEAM_CONVENTIONS empty)"; fi
if [ -n "$TEAM_GIT_KEY" ]; then
  if [ "$(in_sbx "git config --global $TEAM_GIT_KEY 2>/dev/null")" = "$TEAM_GIT_VALUE" ]; then
    ok "team startup command ran ($TEAM_GIT_KEY = $TEAM_GIT_VALUE)"
  else
    bad "team startup command did not run, or this kit overrode it"
  fi
else skip "team startup command (TEAM_GIT_KEY empty)"; fi

info "5. Live values landed"
# The TUI override is optional: drop it from spec.yaml when your team's README
# does not allow a personal OPENCODE_TUI_CONFIG, and these checks skip.
if grep -Eq '^[[:space:]]+OPENCODE_TUI_CONFIG:' "$KIT_DIR/spec.yaml"; then
  tui="$(in_sbx 'printf "%s" "${OPENCODE_TUI_CONFIG:-}"')"
  if [ "$tui" = "$PERSONAL_TUI" ]; then
    ok "OPENCODE_TUI_CONFIG = $tui"
  else
    bad "OPENCODE_TUI_CONFIG unexpected: '${tui:-<unset>}'"
  fi
  if [ "$(in_sbx "test -s $PERSONAL_TUI && echo y")" = "y" ]; then
    ok "TUI config file present"
  else
    bad "TUI config file missing"
  fi
else
  skip "OPENCODE_TUI_CONFIG override (not in spec.yaml)"
fi
if [ "$(in_sbx "test -s $PERSONAL_DROPIN && echo y")" = "y" ]; then
  ok "shell drop-in present"
else
  bad "shell drop-in missing"
fi
# The settle poll above already probed this kit's git key.
if [ "$settled" = 1 ]; then
  ok "startup command ran ($PERSONAL_GIT_KEY = $PERSONAL_GIT_VALUE)"
else
  bad "startup command did not run"
fi
# acq's ~/.profile sources ~/.rc.d in every bash login shell. The drop-in must
# be sourced there exactly once: twice means some layer added its own loop
# (a ~/.bashrc append, the pre-v4 practice), which `acq`'s ~/.profile then
# runs as well. Counted from bash's trace of its `. FILE` lines, so the check
# works whatever the drop-in contains. Last line only for the alias probe:
# ~/.bashrc or a drop-in may print its own output first.
if [ "$(in_sbx "bash -lic 'alias $PERSONAL_ALIAS >/dev/null 2>&1 && echo y' 2>/dev/null" | tail -n1)" = "y" ]; then
  ok "drop-in sourced by a bash login shell (alias $PERSONAL_ALIAS)"
else
  bad "drop-in not sourced by a bash login shell (does ~/.profile run the ~/.rc.d loop?)"
fi
sourced="$(in_sbx "bash -lixc : 2>&1 >/dev/null | grep -cE '^[+]+ (\\.|source) $PERSONAL_DROPIN\$'")"
case "$sourced" in
  1) ok "drop-in sourced exactly once per login shell" ;;
  *) bad "drop-in sourced ${sourced:-?} times per login shell (expected 1; a layer adds its own ~/.rc.d loop, see TROUBLESHOOTING.md)" ;;
esac
# Drop-ins also run in scripted login shells, so one that execs another shell
# without its guards would swallow the script.
if [ "$(in_sbx "bash -lc 'echo ran' 2>/dev/null" | tail -n1)" = "ran" ]; then
  ok "a scripted bash -lc still runs its command"
else
  bad "a scripted bash -lc did not run its command (a drop-in exec'd another shell?)"
fi

info "6. Egress union (docs/scope-layers.md)"
# environment and files[] coexistence is already covered: sections 4 and 5
# assert both kits' variables and files.
# caps.network.allow: union. A host listed by neither kit must get a deny
# code, 000 or 403 (the negative control); each kit's host must get neither.
if [ "$SKIP_NETWORK" = "1" ]; then
  skip "caps.network.allow union (SKIP_NETWORK=1)"
else
  code_denied="$(probe_host "$UNLISTED_EGRESS_HOST")"
  # The backends' deny answers: 000 (no connection, msb) or 403 (proxy, sbx).
  case "$code_denied" in
    000|403) ok "caps.network.allow: unlisted control host denied ($UNLISTED_EGRESS_HOST -> $code_denied)" ;;
    "") bad "caps.network.allow: probe of the unlisted control host failed (no answer from acq exec)" ;;
    *) bad "caps.network.allow: unlisted control host answered $code_denied, not a deny code (000/403): something admits it, so the union cannot be observed" ;;
  esac
  if [ "$code_denied" = 000 ] || [ "$code_denied" = 403 ]; then
    for side in team personal; do
      if [ "$side" = team ]; then
        host="$TEAM_EGRESS_HOST"
        [ -n "$host" ] || { skip "caps.network.allow: team host (TEAM_EGRESS_HOST empty)"; continue; }
      else
        host="$PERSONAL_EGRESS_HOST"
        [ -n "$host" ] || { skip "caps.network.allow: personal host (PERSONAL_EGRESS_HOST empty)"; continue; }
        spec_lists_host "$KIT_DIR/spec.yaml" "$host" \
          || { skip "caps.network.allow: personal host ($host not in spec.yaml)"; continue; }
        spec_lists_host "$TEAM_KIT/spec.yaml" "$host" \
          && { skip "caps.network.allow: personal host ($host is also in the team kit, so this proves nothing)"; continue; }
      fi
      code="$(probe_host "$host")"
      case "$code" in
        000|403|"") bad "caps.network.allow: $side host denied ($host -> ${code:-none}): the union is broken, the host is offline, or its / answers with a deny code (pick another host)" ;;
        *) ok "caps.network.allow: $side host admitted ($host -> $code)" ;;
      esac
    done
  fi
fi

info "7. PERSONAL checks (extend as your kit grows)"
# One assertion per mechanism your kit adds: a drop-in's alias or function, a
# compiled terminfo entry, an installed tool, an included gitconfig... Check a
# key from an included gitconfig with `git config --global --includes KEY`:
# naming one file (--global) turns include.path off, so it comes back empty.
skip "no personal checks yet"

info "Summary"
printf '  %d passed, %d failed, %d skipped\n' "$pass" "$fail" "$skipped"
if [ "$fail" -eq 0 ]; then
  printf '  \033[32mAll checks passed.\033[0m\n'
else
  printf '  \033[31mSome checks failed — see notes above.\033[0m\n'
fi

[ "$fail" -eq 0 ]
