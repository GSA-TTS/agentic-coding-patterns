#!/bin/sh
# opencode — kit-installed wrapper that SHADOWS the real `opencode` binary.
#
# The opencode base image's entrypoint runs the bare, unqualified command
# `opencode`. This wrapper is dropped at ~/.local/bin/opencode, which is FIRST on
# the image PATH (ahead of the npm-global bin where the real opencode lives), so
# the sandbox's interactive startup runs THIS instead. It gives OpenChamber (and
# an optional TUI) a single, shared opencode server to drive.
#
# Behavior:
#   opencode                 → (no args) ensure a shared `opencode serve` is up on
#                              0.0.0.0:4096 (idempotent), print host-connection
#                              instructions, then OFFER to attach a TUI now.
#                              yes → run `opencode attach` as a CHILD (same live
#                              session as the browser); when you QUIT the TUI,
#                              control returns and the wrapper keeps holding the
#                              foreground server, so the sandbox stays up.
#                              no / non-interactive → skip the TUI. EITHER WAY the
#                              wrapper does NOT return — it holds a FOREGROUND
#                              server as PID 1 (see the "must stay PID 1" note
#                              below). A returning wrapper would let the sandbox
#                              entrypoint exit and the sandbox STOP.
#   opencode <anything...>   → passthrough: exec the REAL opencode with the args
#                              unchanged (run, auth, tui with a project, etc.).
#
# WHY THE WRAPPER MUST NOT RETURN (keep PID 1 alive):
#   This wrapper IS the sandbox entrypoint (it shadows the base image's bare
#   `opencode` CMD via PATH). A Docker Sandbox is "running" only while its
#   entrypoint / PID 1 is alive. If this wrapper backgrounds the server and then
#   returns — OR execs a TUI that you later quit — PID 1 exits and the sandbox
#   transitions running -> stopped. So on the no-arg path the wrapper always ends
#   by BLOCKING on a long-lived foreground server (hold_pid1): the TUI, when
#   requested, runs as a CHILD, and quitting it falls through to that hold rather
#   than ending the entrypoint.
#
# The managed server is UNSECURED (no OPENCODE_SERVER_PASSWORD): the sandbox — an
# ephemeral container with proxied, allow-listed egress and no host FS — is the
# security boundary, and its published ports are host loopback only. See the
# kit README "Security note".

set -eu

OC_PORT=4096
OC_HOST=0.0.0.0
SERVE_LOG=/tmp/opencode-serve.log

# --- Resolve the REAL opencode (never ourselves). ---------------------------
# We are ~/.local/bin/opencode and are first on PATH, so `command -v opencode`
# would find US. Search PATH entries explicitly and skip our own path. We know
# our own canonical location (~/.local/bin/opencode) regardless of how $0 was
# set, so compare against that rather than trusting argv[0].
self_dir="${HOME:-/home/agent}/.local/bin"
canon() { ( cd "$(dirname "$1")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "$1")" ); }
self_canon="$(canon "$self_dir/opencode")"
real_opencode=""
_ifs="$IFS"; IFS=:
for _dir in $PATH; do
  [ -n "$_dir" ] || continue
  _cand="$_dir/opencode"
  # Must be an executable regular file (not a directory).
  { [ -x "$_cand" ] && [ ! -d "$_cand" ]; } || continue
  # Skip ourselves, compared canonically so a differently-spelled PATH entry
  # for the same file (./, symlink, trailing slash) can't fool us into
  # re-invoking the wrapper.
  [ "$(canon "$_cand")" = "$self_canon" ] && continue
  real_opencode="$_cand"
  break
done
IFS="$_ifs"
if [ -z "$real_opencode" ]; then
  echo "opencode wrapper: could not locate the real opencode binary on PATH" >&2
  exit 127
fi

# --- Passthrough: any arguments go straight to the real opencode. ------------
if [ "$#" -gt 0 ]; then
  exec "$real_opencode" "$@"
fi

# --- No args: bring up the shared server (idempotent), then offer a TUI. -----
serve_up() {
  # The server answers /global/health once ready. Unsecured, so no auth header.
  curl -fsS "http://127.0.0.1:$OC_PORT/global/health" >/dev/null 2>&1
}

# Start the shared server in the background and wait for it to answer, so the
# host-connect instructions and any TUI attach below are truthful. This is only
# a TEMPORARY background start: on every no-TUI path we replace it by exec'ing a
# foreground server so PID 1 stays alive (see the header "must not return" note).
started_here=0
if serve_up; then
  echo "opencode: shared server already running on 0.0.0.0:$OC_PORT"
else
  echo "opencode: starting shared server on $OC_HOST:$OC_PORT ..."
  nohup "$real_opencode" serve --hostname "$OC_HOST" --port "$OC_PORT" \
    >"$SERVE_LOG" 2>&1 &
  started_here=1
  _i=0
  while [ "$_i" -lt 30 ]; do
    serve_up && break
    _i=$((_i + 1))
    sleep 1
  done
  if serve_up; then
    echo "opencode: shared server is up on $OC_HOST:$OC_PORT"
  else
    echo "opencode: server did not answer yet; see $SERVE_LOG" >&2
  fi
fi

cat <<EOF

────────────────────────────────────────────────────────────────────────────
Connect from your HOST
────────────────────────────────────────────────────────────────────────────
This sandbox publishes two container ports to the host (loopback only). Find
the mapped host ports from your host shell:

    acq ports <sandbox>        # (sbx ports <sandbox>)

  • OpenChamber web UI   → container 3000 → open http://127.0.0.1:<host-port>
  • Raw opencode server  → container $OC_PORT → e.g. attach a host TUI:
        opencode attach http://127.0.0.1:<host-port-for-$OC_PORT>

The browser UI and any attached TUI all drive the SAME server on :$OC_PORT, so
they share one live session.
────────────────────────────────────────────────────────────────────────────
EOF

# Only prompt if we have an interactive terminal; otherwise (e.g. `acq exec`
# without a TTY) don't hang on the prompt — fall through to the foreground hold.
# EITHER WAY we end on hold_pid1 below, so the sandbox stays running: a declined
# prompt AND a TUI you later quit both keep the shared server alive as PID 1.
if [ -t 0 ] && [ -t 1 ]; then
  printf 'Connect a TUI in THIS terminal now? [y/N] '
  read -r _ans || _ans=""
  case "$_ans" in
    [yY] | [yY][eE][sS])
      echo "opencode: attaching TUI to the shared server ..."
      # Run the TUI as a CHILD (not exec): when you quit it, control returns
      # HERE and we fall through to hold_pid1, so the sandbox — and the browser
      # UI sharing this server — stays up. `|| true` so a non-zero TUI exit
      # (e.g. Ctrl-C) under `set -e` doesn't abort the entrypoint.
      "$real_opencode" attach "http://127.0.0.1:$OC_PORT" || true
      echo "opencode: TUI exited; keeping the shared server (and sandbox) alive."
      ;;
  esac
fi

# --- Keep the sandbox alive by holding the FOREGROUND server as PID 1. --------
# Reached on every no-arg path: declined prompt, non-interactive, OR after an
# attached TUI is quit. We are the sandbox entrypoint; if we returned here PID 1
# would exit and the sandbox would stop (the running->stopped bug). So block on
# a long-lived foreground process instead of returning.
cat <<EOF
The shared server runs in the FOREGROUND as the sandbox's main process (so the
sandbox stays running). Attach a TUI to the SAME session any time:

    # from the host:
    acq exec <sandbox> -- opencode attach http://127.0.0.1:$OC_PORT
    # or open a shell and run \`opencode attach http://127.0.0.1:$OC_PORT\`.

Server log: $SERVE_LOG
EOF

hold_pid1() {
  if [ "$started_here" -eq 1 ]; then
    # A background server we launched is already bound to :$OC_PORT. Don't start
    # a second one (the port is taken); keep PID 1 alive by waiting on that
    # background job. `wait` blocks in the foreground until it exits, so the
    # entrypoint stays open for the sandbox's lifetime.
    wait
  else
    # The server was already up before this wrapper ran (e.g. OpenChamber's
    # skip-start supervisor, or an earlier wrapper invocation, owns :$OC_PORT).
    # We must NOT start a second server on the same port (it would fail to bind
    # and, under `set -e`, kill this entrypoint — reintroducing the stop bug).
    # Instead, hold PID 1 open by parking on a harmless foreground loop that
    # keeps re-checking the server is alive. If the pre-existing server ever
    # disappears, we exit the loop and become the foreground server ourselves.
    echo "opencode: holding sandbox open; shared server already owns :$OC_PORT" >>"$SERVE_LOG"
    while serve_up; do
      sleep 30
    done
    echo "opencode: shared server on :$OC_PORT went away; taking over in foreground" >>"$SERVE_LOG"
    exec "$real_opencode" serve --hostname "$OC_HOST" --port "$OC_PORT" \
      >>"$SERVE_LOG" 2>&1
  fi
}

hold_pid1
