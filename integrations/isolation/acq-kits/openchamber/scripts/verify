#!/usr/bin/env bash
#
# verify — host-side validation for the openchamber acq mixin kit.
#
# Two layers:
#
#   1. OFFLINE GATE (always runs): the backend-agnostic validator
#      integrations/isolation/acq-kits/validate-kits.py (schema + files[].source
#      + registry). Needs python3 with jsonschema + pyyaml; if those aren't
#      importable this check reports SKIP (with the fix), not a false FAIL.
#
#   2. LIVE END-TO-END (opt-in): create a real sandbox with the kit applied,
#      then assert the wrapper, the on-demand shared server, OpenChamber, the
#      published ports, and the respawn supervisor.
#
#      Preferred driver — RUN_ACQ=1: drive the `acq` CLI. acq translates the
#      neutral hybrid/v1 spec to an sbx-v2 kit (kit_translate_to_sbx) and applies
#      it, so the kit's `files:`/`commands:` land correctly. As of quickstart#221
#      (merged) acq carries backend_extras.sbx.publishedPorts, so ports 3000/4096
#      are published at CREATE time — no manual step. This script verifies that
#      and only falls back to an explicit `acq ports --publish` on an older acq
#      that predates #221.
#
#      Legacy driver — RUN_SBX=1: drive `sbx` directly on the NEUTRAL spec. sbx
#      cannot parse the neutral schema (it expects sbx-v2), so `sbx create --kit`
#      on this kit fails ("field files not found", "cannot unmarshal !!seq into
#      CommandsPolicy", "field backend_extras not found"). This path therefore
#      requires a PRE-TRANSLATED sbx-v2 kit dir in SBX_KIT_DIR; without it the
#      script reports SKIP with guidance rather than a misleading FAIL. Prefer
#      RUN_ACQ=1.
#
# Run on a host where `acq` (RUN_ACQ) or `sbx` >= 0.35.0 (RUN_SBX) is installed
# and logged in. The USAi kit needs a USAi key; set one first if you want the
# shared server to come up fully:
#   acq secret set-custom -g --host api.gsa.usai.gov --env USAI_API_KEY
#
# Usage (from anywhere):
#   path/to/openchamber/scripts/verify              # offline gate only (default)
#   RUN_ACQ=1 path/to/.../scripts/verify            # live, via acq (preferred)
#   KEEP=1 RUN_ACQ=1 path/to/.../scripts/verify     # keep the sandbox to inspect
#   RUN_SBX=1 SBX_KIT_DIR=<translated> .../verify   # live, via sbx (needs sbx-v2 dir)

set -uo pipefail

KIT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# Repo root (…/agentic-coding-patterns) for the backend-agnostic validator.
REPO_ROOT="$(cd "$KIT_DIR/../../../.." && pwd)"
# Sibling acq-kits applied alongside, to mirror real GSA usage:
#  - usai-provider:          gives `opencode serve` a model provider.
#  - zscaler-ca-certificate: populates the system trust store, which the startup
#    install folds into NODE_EXTRA_CA_CERTS so the prebuilt better-sqlite3 binary
#    downloads (rather than failing TLS and falling back to a source build).
# Both are local paths here (the verify runs from a repo checkout).
USAI_KIT_DIR="$(cd "$KIT_DIR/../usai-provider" 2>/dev/null && pwd || true)"
ZSCALER_KIT_DIR="$(cd "$KIT_DIR/../zscaler-ca-certificate" 2>/dev/null && pwd || true)"
SBX_NAME="openchamber-verify-$$"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/openchamber-verify.XXXXXX")"
CREATE_LOG="$WORK/create.log"
KEEP="${KEEP:-0}"
# Which live driver to use. RUN_ACQ takes precedence. DRIVER is set below.
RUN_ACQ="${RUN_ACQ:-0}"
RUN_SBX="${RUN_SBX:-0}"
# For the RUN_SBX legacy path: a pre-translated sbx-v2 kit dir (see header).
SBX_KIT_DIR="${SBX_KIT_DIR:-}"
# How long to wait for the background startup, which on FIRST boot also installs
# OpenChamber (npm install of a native dep). Override with READY_TIMEOUT.
READY_TIMEOUT="${READY_TIMEOUT:-120}"
# Poll interval while waiting. Small so failures surface quickly.
POLL_INTERVAL="${POLL_INTERVAL:-2}"
# Once the install is done, the servers should come up fast; stop waiting this
# many seconds after install completes even if a server never answers, so a
# broken serve/UI fails quickly instead of burning the whole READY_TIMEOUT.
POST_INSTALL_GRACE="${POST_INSTALL_GRACE:-20}"

pass=0
fail=0
ok()   { printf '  \033[32mPASS\033[0m %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }
skip() { printf '  \033[33mSKIP\033[0m %s\n' "$1"; }
# warn: a non-fatal note (does NOT count toward fail) — e.g. an older acq took a
# documented fallback path. The run can still pass.
warn() { printf '  \033[33mWARN\033[0m %s\n' "$1"; }
info() { printf '\n\033[1m%s\033[0m\n' "$1"; }

cleanup() {
  if [ "$KEEP" = "1" ]; then
    printf '\nKEEP=1 set; leaving sandbox %s and %s in place.\n' "$SBX_NAME" "$WORK" >&2
    return
  fi
  case "${DRIVER:-}" in
    acq) acq rm "$SBX_NAME" >/dev/null 2>&1 || true ;;
    *)   sbx rm -f "$SBX_NAME" >/dev/null 2>&1 || true ;;
  esac
  rm -rf "$WORK" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# --- Driver abstraction: exec a command inside the sandbox (non-TTY). --------
# acq exec NAME -- CMD and sbx exec NAME -- CMD have the same shape; both are
# non-TTY by default. We swallow transient exec errors so a probe never aborts
# the run.
in_sbx() {
  case "${DRIVER:-}" in
    acq) acq exec "$SBX_NAME" -- sh -c "$1" </dev/null 2>/dev/null || true ;;
    *)   sbx exec "$SBX_NAME" -- sh -c "$1" </dev/null 2>/dev/null || true ;;
  esac
}
# List published ports for the sandbox.
sbx_ports_out() {
  case "${DRIVER:-}" in
    acq) acq ports "$SBX_NAME" 2>/dev/null || true ;;
    *)   sbx ports "$SBX_NAME" 2>/dev/null || true ;;
  esac
}

info "0. Preconditions"
[ -f "$KIT_DIR/spec.yaml" ] && ok "kit spec.yaml present" || { bad "spec.yaml missing"; exit 1; }

info "1. Validate the neutral kit spec"
# This is a hybrid/v1 acq kit; the backend-agnostic gate is validate-kits.py
# (schema + files[].source resolution + registry cross-check), not `sbx kit
# validate` (which only understands the translated sbx spec). Distinguish three
# outcomes so a missing Python dep is reported as SKIP (with the fix), not as a
# false FAIL that looks like a kit problem.
VALIDATOR="$REPO_ROOT/integrations/isolation/acq-kits/validate-kits.py"
if ! command -v python3 >/dev/null 2>&1; then
  skip "validate-kits.py not run (python3 not on PATH)"
elif [ ! -f "$VALIDATOR" ]; then
  skip "validate-kits.py not found at $VALIDATOR"
elif ! python3 -c 'import jsonschema, yaml' >/dev/null 2>&1; then
  skip "validate-kits.py needs 'jsonschema' + 'pyyaml' — install them (pip install jsonschema pyyaml) and re-run"
else
  # Deps present: run it and, on failure, SHOW the real error instead of hiding it.
  if val_out="$(python3 "$VALIDATOR" --root "$REPO_ROOT" 2>&1)"; then
    ok "acq-kits validate-kits.py passes (schema + registry)"
  else
    bad "validate-kits.py failed:"
    printf '%s\n' "$val_out" | sed 's/^/    | /' >&2
  fi
fi

# --- Select the live driver. -------------------------------------------------
# RUN_ACQ takes precedence over RUN_SBX. If neither is set, run offline only.
DRIVER=""
if [ "$RUN_ACQ" = "1" ]; then
  DRIVER="acq"
elif [ "$RUN_SBX" = "1" ]; then
  DRIVER="sbx"
fi

if [ -z "$DRIVER" ]; then
  info "Live sandbox checks (2-8): SKIPPED"
  echo "  Set RUN_ACQ=1 to run the live end-to-end check via acq (preferred)." >&2
  echo "  (RUN_SBX=1 also works but needs a pre-translated sbx-v2 kit; see header.)" >&2
  info "Summary"
  printf '  %d passed, %d failed\n' "$pass" "$fail"
  [ "$fail" -eq 0 ] && printf '  \033[32mOffline gate passed.\033[0m\n' || printf '  \033[31mOffline gate failed — see above.\033[0m\n'
  exit "$([ "$fail" -eq 0 ] && echo 0 || echo 1)"
fi

if ! command -v "$DRIVER" >/dev/null 2>&1; then
  echo "  RUN_${DRIVER^^}=1 set but '$DRIVER' not on PATH. Install it and retry." >&2
  exit 1
fi
echo "  driver: $DRIVER"
if [ "$DRIVER" = "sbx" ]; then
  echo "  sbx version: $(sbx version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1)"
fi

info "2. Create a sandbox with the kit"
if [ "$DRIVER" = "acq" ]; then
  # acq translates the neutral hybrid/v1 spec to sbx-v2 and applies it. The kit
  # under test is passed as an ACQ_EXTRA_KITS *local path*; acq's kit_translate_fetch
  # accepts a bare directory path and uses it verbatim. The usai/zscaler kits are
  # already in acq's built-in pinned set, so we don't re-add them here.
  echo "  creating $SBX_NAME via acq (extra kit: $KIT_DIR)..."
  if ACQ_EXTRA_KITS="$KIT_DIR" acq create --name "$SBX_NAME" opencode "$WORK" >"$CREATE_LOG" 2>&1; then
    ok "sandbox created via acq (kit translated + applied)"
  else
    bad "acq create failed (exit $?)"
    sed 's/^/  | /' "$CREATE_LOG" >&2
    exit 1
  fi
  # As of quickstart#221 (merged) acq carries backend_extras.sbx.publishedPorts
  # through translation, so a current acq publishes 3000/4096 at CREATE time — no
  # manual step. Verify that here: check the mappings exist post-create. If they
  # don't (an older acq predating #221), fall back to an explicit publish so the
  # rest of the run still exercises the kit. Step 7 re-asserts the mappings.
  info "2b. Container ports 3000 and 4096 published at create (quickstart#221)"
  for cport in 3000 4096; do
    if acq ports "$SBX_NAME" 2>/dev/null | grep -q "$cport"; then
      ok "container $cport auto-published at create"
    else
      warn "container $cport not auto-published — older acq (pre-#221)? falling back to manual publish"
      if acq ports "$SBX_NAME" --publish "${cport}:${cport}" >/dev/null 2>&1; then
        ok "container $cport published via fallback (acq ports --publish)"
      else
        bad "failed to publish container $cport (acq ports --publish)"
      fi
    fi
  done
else
  # RUN_SBX legacy path: sbx cannot parse the NEUTRAL spec. Require a
  # pre-translated sbx-v2 kit dir; otherwise SKIP with guidance rather than
  # emitting a misleading create failure.
  if [ -z "$SBX_KIT_DIR" ]; then
    info "Live sandbox checks (2-8): SKIPPED"
    echo "  RUN_SBX=1 needs a PRE-TRANSLATED sbx-v2 kit dir in SBX_KIT_DIR." >&2
    echo "  sbx cannot parse the neutral hybrid/v1 spec directly (it fails with" >&2
    echo "  'field files not found' / 'cannot unmarshal !!seq into CommandsPolicy'" >&2
    echo "  / 'field backend_extras not found'). Prefer RUN_ACQ=1, which translates" >&2
    echo "  automatically. To use RUN_SBX, translate first (acq's kit_translate_to_sbx)" >&2
    echo "  and point SBX_KIT_DIR at the output." >&2
    info "Summary"
    printf '  %d passed, %d failed\n' "$pass" "$fail"
    [ "$fail" -eq 0 ] && printf '  \033[32mOffline gate passed; live checks skipped.\033[0m\n' \
      || printf '  \033[31mOffline gate failed — see above.\033[0m\n'
    exit "$([ "$fail" -eq 0 ] && echo 0 || echo 1)"
  fi
  create_kits=(--kit "$SBX_KIT_DIR")
  if [ -n "$USAI_KIT_DIR" ] && [ -f "$USAI_KIT_DIR/spec.yaml" ]; then
    create_kits+=(--kit "$USAI_KIT_DIR")
    echo "  pairing with usai-provider kit at $USAI_KIT_DIR"
  else
    echo "  NOTE: usai-provider kit not found next to this kit; creating without a" >&2
    echo "        provider. 'opencode serve' may not fully start (server checks SKIP)." >&2
  fi
  if [ -n "$ZSCALER_KIT_DIR" ] && [ -f "$ZSCALER_KIT_DIR/spec.yaml" ]; then
    create_kits+=(--kit "$ZSCALER_KIT_DIR")
    echo "  pairing with zscaler-ca-certificate kit at $ZSCALER_KIT_DIR"
  else
    echo "  NOTE: zscaler-ca-certificate kit not found next to this kit. On an" >&2
    echo "        HTTPS-inspected network the OpenChamber install may fail TLS." >&2
  fi
  echo "  creating $SBX_NAME (workspace $WORK) from translated kit $SBX_KIT_DIR..."
  # -D/--debug surfaces the underlying container-runtime error behind sbx's
  # generic "500 ... failed to run sandbox container". Set DEBUG=1 to include it.
  dbg=(); [ "${DEBUG:-0}" = "1" ] && dbg=(-D)
  # Expand dbg[@] safely: an empty array under `set -u` on bash 3.2 (macOS)
  # otherwise errors with "dbg[@]: unbound variable".
  if sbx ${dbg[@]+"${dbg[@]}"} create --name "$SBX_NAME" "${create_kits[@]}" opencode "$WORK" >"$CREATE_LOG" 2>&1; then
    ok "sandbox created with --kit"
  else
    bad "sbx create failed (exit $?)"
    sed 's/^/  | /' "$CREATE_LOG" >&2
    exit 1
  fi
fi

info "3. Wait for startup install + OpenChamber (install up to ${READY_TIMEOUT}s, then ${POST_INSTALL_GRACE}s)"
# The background startup step installs OpenChamber on first boot, then supervises
# OpenChamber (skip-start mode). It does NOT start opencode serve — the wrapper
# owns that on demand (checked separately below). So here we only wait for the
# install and for OpenChamber to answer.
deadline=$(( $(date +%s) + READY_TIMEOUT ))
installed=""; chamber_up=""; grace_deadline=""
while :; do
  now=$(date +%s)
  [ -z "$installed" ] && [ -n "$(in_sbx 'command -v openchamber')" ] && {
    installed=yes
    # Install done — OpenChamber should appear within POST_INSTALL_GRACE.
    grace_deadline=$(( now + POST_INSTALL_GRACE ))
  }
  [ -z "$chamber_up" ] && [ "$(in_sbx 'curl -fsS http://127.0.0.1:3000 >/dev/null 2>&1 && echo yes')" = "yes" ] && chamber_up=yes
  [ -n "$installed" ] && [ -n "$chamber_up" ] && break
  # Stop conditions: overall deadline, or the post-install grace elapsed.
  [ "$now" -ge "$deadline" ] && break
  [ -n "$grace_deadline" ] && [ "$now" -ge "$grace_deadline" ] && break
  sleep "$POLL_INTERVAL"
done

if [ -n "$installed" ]; then
  ok "OpenChamber CLI installed by the startup step"
else
  bad "openchamber not installed (see /tmp/openchamber-install.log)"
  in_sbx 'tail -n 25 /tmp/openchamber-install.log' | sed 's/^/    | /'
fi

info "4. opencode wrapper installed and shadows the real binary"
# The wrapper must be at ~/.local/bin/opencode and resolve FIRST on PATH.
wrapper_path="$(in_sbx 'command -v opencode')"
case "$wrapper_path" in
  */.local/bin/opencode)
    ok "opencode resolves to the wrapper ($wrapper_path)" ;;
  "")
    bad "opencode not found on PATH in the sandbox" ;;
  *)
    bad "opencode resolves to '$wrapper_path', not ~/.local/bin/opencode (wrapper not shadowing)" ;;
esac
# Sanity: the dropped file is executable.
[ -n "$(in_sbx 'test -x ~/.local/bin/opencode && echo yes')" ] \
  && ok "wrapper file is executable" \
  || bad "~/.local/bin/opencode missing or not executable"

info "5. Shared opencode server (started on demand by the wrapper)"
# The server is on-demand: nothing listens on :4096 until the wrapper runs. The
# wrapper is the sandbox ENTRYPOINT, so on its no-arg, no-TTY path it does NOT
# return — it foregrounds `opencode serve` to keep PID 1 (the sandbox) alive.
# Running it here with a plain `acq exec` would therefore BLOCK forever. Start it
# DETACHED (background + nohup) — the same lifecycle the entrypoint has — and
# then probe the port it brings up.
in_sbx 'nohup opencode >/tmp/wrapper-run.log 2>&1 & echo started'
oc_up=""
oc_deadline=$(( $(date +%s) + 20 ))
while :; do
  [ "$(in_sbx 'curl -fsS http://127.0.0.1:4096/global/health >/dev/null 2>&1 && echo yes')" = "yes" ] && { oc_up=yes; break; }
  [ "$(date +%s)" -ge "$oc_deadline" ] && break
  sleep "$POLL_INTERVAL"
done
if [ -n "$oc_up" ]; then
  ok "shared opencode server answers on 127.0.0.1:4096 after running the wrapper"
elif [ "$DRIVER" = "acq" ] || [ -n "$USAI_KIT_DIR" ]; then
  # A provider is expected: acq applies usai-provider as a built-in kit, and the
  # sbx path pairs USAI_KIT_DIR. Without a USAi *key* the server may still not
  # come up — treat as FAIL only when a provider kit is present; the key itself
  # is the operator's responsibility (see the header).
  bad "shared server did not answer on :4096 (see the serve log; is a USAi key set?)"
  in_sbx 'tail -n 20 "${XDG_STATE_HOME:-$HOME/.local/state}/openchamber/opencode-serve.log"' | sed 's/^/    | /'
else
  skip "shared server on :4096 (no provider configured — expected without USAi key)"
fi

info "6. OpenChamber web server"
if [ -n "$chamber_up" ]; then
  ok "OpenChamber answers on 127.0.0.1:3000 inside the sandbox"
else
  bad "OpenChamber did not answer on :3000 (see /tmp/openchamber.log)"
  in_sbx 'tail -n 20 /tmp/openchamber.log' | sed 's/^/    | /'
fi

info "7. Host ports published for container 3000 and 4096"
ports_out="$(sbx_ports_out)"
for cport in 3000 4096; do
  if printf '%s' "$ports_out" | grep -q "$cport"; then
    ok "ports maps container $cport to a host port"
  else
    bad "no host mapping for container $cport in 'ports' output"
  fi
done
printf '%s\n' "$ports_out" | sed 's/^/    | /'

info "8. OpenChamber respawn supervisor running (auto-restart)"
# OpenChamber runs under a loop marked "supervisor:openchamber" in its argv, so a
# process exit (self-update/crash) is followed by a restart. Assert exactly one
# supervisor is alive (guards against duplicates on re-runs). The shared server is
# NOT supervised — the wrapper starts one instance on demand — so there is no
# opencode-serve supervisor to check anymore.
ch_sup="$(in_sbx 'pgrep -c -f "supervisor:openchamber" 2>/dev/null')"
[ "${ch_sup:-0}" -ge 1 ] 2>/dev/null && ok "openchamber supervisor running (count=$ch_sup)" \
  || bad "no openchamber supervisor found (auto-restart not active)"

info "9. Sandbox stays 'running' (wrapper entrypoint does not exit) — regression guard"
# REGRESSION GUARD (the running->stopped bug): the wrapper IS the sandbox
# entrypoint. If its no-arg path backgrounds the server and RETURNS, PID 1 exits
# and the sandbox stops on its own moments after create. The fixed wrapper
# instead holds a foreground `opencode serve` (waits on / execs it) so PID 1
# stays alive. We can't easily attach the entrypoint from a test, so we assert
# the *invariant* that makes the entrypoint safe: running the wrapper no-arg,
# no-TTY BLOCKS (holds the process open) rather than returning. Do it with a
# bounded timeout; a return within the window is the BUG, a timeout is the FIX.
#
# `timeout` may be absent on macOS hosts, but this runs INSIDE the sandbox via
# `sh -c`, where coreutils `timeout` is present. Exit 124 == timed out (good).
wrapper_probe="$(in_sbx '
  if command -v timeout >/dev/null 2>&1; then
    timeout 8 opencode </dev/null >/dev/null 2>&1
    echo "rc=$?"
  else
    echo "rc=notimeout"
  fi
')"
case "$wrapper_probe" in
  *rc=124*)
    ok "wrapper no-arg path stays in the foreground (entrypoint won't exit → sandbox stays running)" ;;
  *rc=notimeout*)
    skip "could not run the entrypoint-liveness probe (no 'timeout' in sandbox)" ;;
  *)
    bad "wrapper no-arg path RETURNED (${wrapper_probe}); as the entrypoint this exits PID 1 and stops the sandbox"
    in_sbx 'tail -n 20 "${XDG_STATE_HOME:-$HOME/.local/state}/openchamber/opencode-serve.log"' | sed 's/^/    | /' ;;
esac

info "10. Sandbox survives an attached TUI being quit — regression guard"
# REGRESSION GUARD (the TUI-exit stop bug): on the "yes, attach a TUI" path an
# earlier wrapper `exec`ed `opencode attach`, so the TUI BECAME PID 1 and quitting
# it stopped the sandbox. The fix runs the TUI as a CHILD and falls through to the
# same foreground hold, so a quit TUI returns to the wrapper instead of ending the
# entrypoint. That path only triggers with a TTY (the prompt is TTY-gated), which
# `acq exec` doesn't give us, so assert the two source invariants that make it
# safe: (a) the attach line is NOT exec'd, and (b) the script ends by calling
# hold_pid1. Read the wrapper file that was actually dropped INTO the sandbox.
wrapper_src="$(in_sbx 'cat ~/.local/bin/opencode 2>/dev/null')"
if [ -z "$wrapper_src" ]; then
  bad "could not read ~/.local/bin/opencode from the sandbox to check TUI-exit survival"
else
  if printf '%s\n' "$wrapper_src" | grep -Eq '^[[:space:]]*exec[[:space:]]+"?\$real_opencode"?[[:space:]]+attach'; then
    bad "wrapper EXECs 'opencode attach' — quitting the TUI would exit PID 1 and stop the sandbox"
  else
    ok "wrapper runs 'opencode attach' as a child (not exec) — TUI quit won't end the entrypoint"
  fi
  if printf '%s\n' "$wrapper_src" | grep -Eq '^[[:space:]]*hold_pid1[[:space:]]*$'; then
    ok "wrapper ends by holding PID 1 (hold_pid1), so a quit TUI falls through to the foreground server"
  else
    bad "wrapper does not end in a hold_pid1 call — a quit TUI may let the entrypoint return"
  fi
fi

info "11. Sandbox survives the shared server dying — self-heal regression guard"
# REGRESSION GUARD (the reviewer's must-fix): if the server hold_pid1 holds ever
# dies (crash/OOM/lost bind race), the loop must (re)launch a server and keep
# blocking — it must NEVER return, or PID 1 exits and the sandbox stops. Prove it
# live: bring the server up, KILL it, and confirm a server is answering again
# afterward (self-heal) AND the sandbox is still reachable.
#
# We drive a detached wrapper as the "holder" (its hold_pid1 loop re-launches),
# then kill the serve process out from under it and re-probe :4096.
health='curl -fsS http://127.0.0.1:4096/global/health >/dev/null 2>&1 && echo yes'
# Ensure a holder + server are up (step 5 already ran one; this is idempotent).
in_sbx 'nohup opencode >/dev/null 2>&1 & echo started'
# Wait for a server to answer before we try to kill it.
heal_pre=""
pre_deadline=$(( $(date +%s) + 20 ))
while :; do
  [ "$(in_sbx "$health")" = "yes" ] && { heal_pre=yes; break; }
  [ "$(date +%s)" -ge "$pre_deadline" ] && break
  sleep "$POLL_INTERVAL"
done
if [ -z "$heal_pre" ]; then
  skip "self-heal guard: no server was up to kill (provider/USAi key likely missing)"
else
  # Kill the actual `opencode serve` process (not the wrapper/holder). pkill -f
  # matches the serve command line; the wrapper's hold_pid1 should relaunch it.
  in_sbx 'pkill -f "opencode serve --hostname" 2>/dev/null; echo killed'
  healed=""
  heal_deadline=$(( $(date +%s) + 30 ))   # allow reheal loop + serve readiness
  while :; do
    [ "$(in_sbx "$health")" = "yes" ] && { healed=yes; break; }
    [ "$(date +%s)" -ge "$heal_deadline" ] && break
    sleep "$POLL_INTERVAL"
  done
  if [ -n "$healed" ]; then
    ok "shared server was re-launched after being killed (hold_pid1 self-healed; PID 1 held)"
  else
    bad "shared server did NOT come back after being killed — hold_pid1 may have returned (sandbox would stop)"
    in_sbx 'tail -n 20 "${XDG_STATE_HOME:-$HOME/.local/state}/openchamber/opencode-serve.log"' | sed 's/^/    | /'
  fi
fi

info "Summary"
[ "$fail" -eq 0 ] && printf '  \033[32mAll checks passed.\033[0m\n' || printf '  \033[31mSome checks failed — see notes above.\033[0m\n'

[ "$fail" -eq 0 ]
