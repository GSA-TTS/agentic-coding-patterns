#!/usr/bin/env bash
#
# verify — host-side validation for the usai-provider acq mixin kit.
#
# NOTE (hybrid/v1): this kit's spec.yaml is now the NEUTRAL schemaVersion
# "hybrid/v1" form. The backend-agnostic gate is the repo's schema validator
# (integrations/isolation/acq-kits/validate-kits.py). THIS script is the live,
# per-backend end-to-end check for the sbx-translation path — it drives the sbx
# CLI directly and therefore needs acq's kit-translate layer (Phase 2 Part B) to
# emit an sbx-native spec, OR an sbx build that accepts hybrid/v1. Until Part B
# lands the translate layer, run this only where `acq run --backend sbx` is
# available; on a plain sbx it exercises the translated output, not this file
# verbatim. Live sandbox verification is otherwise deferred (this repo's CI
# cannot create nested sandboxes).
#
# Run on a host where a backend CLI (`sbx` >= 0.34.0) is installed and logged in.
# It validates the kit spec, creates a sandbox with the kit applied, and confirms
# OpenCode's GLOBAL config carries the USAi provider (config present at
# ~/.config/opencode/opencode.jsonc, contains provider.usai, a pre-seeded
# foreign global key survives the merge, and the USAi API is reachable).
#
# It creates a temporary sandbox named "usai-kit-verify-*" and removes it at the
# end (and on interrupt). It does not touch your other sandboxes. Nothing here
# prints secret values.
#
# Usage (from anywhere):
#   path/to/usai-provider/scripts/verify
#   KEEP=1 path/to/.../scripts/verify        # keep the sandbox for inspection
#
# Prerequisite: store the USAi API key once (acq injects it via the backend):
#   acq secret set usai --host api.gsa.usai.gov

set -uo pipefail

KIT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SBX_NAME="usai-kit-verify-$$"
WORK="$(mktemp -d "${TMPDIR:-/tmp}/usai-kit-verify.XXXXXX")"
CREATE_LOG="$WORK/sbx-create.log"
KEEP="${KEEP:-0}"
USAI_MODELS_URL="https://api.gsa.usai.gov/api/v1/models"

# Shared verdict contract (ok / bad / unver / skip / warn + verify_verdict).
# Sourced rather than redefined here so a future fix to the contract cannot
# leave this kit's copy behind.
. "$KIT_DIR/../verify-report.sh"
verify_reset

cleanup() {
  if [ "$KEEP" = "1" ]; then
    printf '\nKEEP=1 set; leaving sandbox %s and %s in place.\n' "$SBX_NAME" "$WORK" >&2
    return
  fi
  sbx rm -f "$SBX_NAME" >/dev/null 2>&1 || true
  rm -rf "$WORK" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

in_sbx() { sbx exec "$SBX_NAME" -- sh -c "$1" </dev/null 2>/dev/null || true; }

info "0. Preconditions"
if ! command -v sbx >/dev/null 2>&1; then
  unver "sbx not on PATH — install sbx >= 0.34.0 and retry"
  verify_verdict "Summary"
  exit $?
fi
echo "  sbx version: $(sbx version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1)"
[ -f "$KIT_DIR/spec.yaml" ] && ok "kit spec.yaml present" || { bad "spec.yaml missing"; exit 1; }
if sbx secret ls 2>/dev/null | grep -q 'api.gsa.usai.gov'; then
  ok "USAi custom secret is set"
else
  unver "USAi custom secret is not set — the credential path cannot be exercised (sbx secret set-custom -g --host api.gsa.usai.gov --env USAI_API_KEY)"
fi

info "1. sbx kit validate"
if sbx kit validate "$KIT_DIR" >/dev/null 2>&1; then ok "kit validates"; else bad "kit failed validation"; fi

info "2. Create a sandbox with the kit"
echo "  creating $SBX_NAME (workspace $WORK)..."
if sbx create --name "$SBX_NAME" --kit "$KIT_DIR" opencode "$WORK" >"$CREATE_LOG" 2>&1; then
  ok "sandbox created with --kit"
else
  bad "sbx create failed (exit $?)"
  sed 's/^/  | /' "$CREATE_LOG" >&2
  exit 1
fi
sleep 2

info "3. Neutral provider snapshot is present; OpenCode owns rendering"
snapshot="/home/agent/usai-config/model-catalog-snapshot.json"
[ "$(in_sbx "test -f \"$snapshot\" && echo yes")" = "yes" ] \
  && ok "neutral provider snapshot present at $snapshot" || bad "neutral provider snapshot missing at $snapshot"
[ "$(in_sbx "grep -q '\"providerId\": \"usai\"' \"$snapshot\" 2>/dev/null && echo yes")" = "yes" ] \
  && ok "neutral provider snapshot identifies USAi" || bad "neutral provider snapshot lacks USAi identity"

info "3b. Renderer contract is verified by the OpenCode kit test suite"
ok "no provider-owned OpenCode merge writer is invoked"

info "4. USAi API reachable from the sandbox (uses injected key)"
status="$(in_sbx "curl -sS -o /dev/null -w '%{http_code}' -H \"Authorization: Bearer \$USAI_API_KEY\" $USAI_MODELS_URL")"
echo "  HTTP status: ${status:-<none>}"
if [ "$status" = "200" ]; then
  ok "USAi models API returned 200"
elif [ -z "$status" ]; then
  # in_sbx swallows the exit status, so an empty result means either "no curl in
  # the guest" or "sbx exec failed" — both are "could not look", never a pass.
  unver "USAi models API — could not probe (no curl in the guest, or no network)"
else
  bad "USAi API returned $status (key missing/expired, or egress blocked)"
  echo "  Check: sbx policy log $SBX_NAME (api.gsa.usai.gov), and the USAi secret." >&2
fi

verify_verdict "Summary"
