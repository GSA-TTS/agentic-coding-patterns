#!/usr/bin/env bash
#
# verify — host-side validation for the paseo acq mixin kit.
#
# Two layers:
#
#   1. OFFLINE GATE (always runs): the backend-agnostic validator
#      integrations/isolation/acq-kits/validate-kits.py (schema + files[].source
#      + registry). Needs python3 with jsonschema + pyyaml; if those aren't
#      importable this check reports SKIP (with the fix), not a false FAIL.
#
#   2. LIVE END-TO-END (opt-in): create a real sandbox with the kit applied, then
#      assert the Paseo CLI install, the wrapper, the startup-supervised daemon +
#      web UI (on one port), the published port, that the LARGE UI bundle arrives
#      byte-complete over the host port (identity encoding; integrity guard), the
#      in-guest 0.0.0.0 bind (reachable via create-time publish) over the host port, the
#      install ran with lifecycle scripts disabled (hardening #2), the npm cache
#      remains agent-owned, the respawn supervisor, the PID-1 hold, the
#      worktree-root pin, daemon self-heal, and that projects are pre-populated
#      from the mounted host dirs — including that a read-write extra workspace IS
#      registered and a ":ro" one is SKIPPED.
#
#      Preferred driver — RUN_ACQ=1: drive the `acq` CLI. acq translates the
#      neutral hybrid/v1 spec to an sbx-v2 kit (kit_translate_to_sbx) and applies
#      it, so the kit's files:/commands: land correctly, and acq publishes port
#      6767 at CREATE time from the neutral publishedPorts — no manual step.
#
#      Legacy driver — RUN_SBX=1: drive `sbx` on a PRE-TRANSLATED sbx-v2 kit dir
#      (SBX_KIT_DIR). sbx cannot parse the neutral schema; without SBX_KIT_DIR
#      this path SKIPs with guidance. Prefer RUN_ACQ=1.
#
# Usage (from anywhere):
#   path/to/paseo/scripts/verify              # offline gate only (default)
#   RUN_ACQ=1 path/to/.../scripts/verify      # live, via acq (preferred)
#   KEEP=1 RUN_ACQ=1 path/to/.../scripts/verify   # keep the sandbox to inspect
#   RUN_SBX=1 SBX_KIT_DIR=<translated> .../verify # live, via sbx (needs sbx-v2 dir)

set -uo pipefail

KIT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# Repo root (…/agentic-coding-patterns) for the backend-agnostic validator.
REPO_ROOT="$(cd "$KIT_DIR/../../../.." && pwd)"
# Sibling zscaler kit applied alongside so the npm install works on an inspected
# network (its CA lands in the system trust store, which the startup script folds
# into NODE_EXTRA_CA_CERTS). Local path here (verify runs from a repo checkout).
ZSCALER_KIT_DIR="$(cd "$KIT_DIR/../zscaler-ca-certificate" 2>/dev/null && pwd || true)"
SBX_NAME="paseo-verify-$$"
# Throwaway workspace for the sandbox. Use a dir LOCAL TO THE KIT (not $TMPDIR)
# so the mount path resembles NORMAL `acq` usage: the first positional arg to
# `acq create`/`acq run` becomes the guest Workdir, and worktrees land under it.
# A $TMPDIR path (macOS /private/var/folders/...) both looks unusual on `msb
# inspect` and, because the guest mounts it at the SAME host path, doesn't match
# the fixed guest workspace — obscuring where worktrees actually land. Keeping it
# under the kit dir avoids both. Cleaned up on exit (unless KEEP=1).
# NOTE: the workspace directory name must NOT begin with "." — the project
# registrar (paseo-register-mounts.mjs) deliberately skips mounts whose target
# basename starts with "." (to exclude backend runtime dirs like /.msb). A
# dot-leading workspace name would make the PRIMARY mount ineligible and defeat
# step 10. Use a plain "verify-workspace." prefix.
WORK="$(mktemp -d "$KIT_DIR/verify-workspace.XXXXXX")"
CREATE_LOG="$WORK/create.log"
# Extra workspaces mounted alongside the primary to exercise the registrar's
# read-write vs read-only distinction in step 10: RO_FIXTURE is mounted ":ro"
# (must be SKIPPED), RW_FIXTURE is mounted read-write and shaped like a parent
# directory containing repos (its child repos must be REGISTERED).
RW_FIXTURE="$(mktemp -d "$KIT_DIR/verify-rw-mount.XXXXXX")"
RO_FIXTURE="$(mktemp -d "$KIT_DIR/verify-ro-mount.XXXXXX")"
RW_CHILD_REPO_A="$RW_FIXTURE/repo-a"
RW_CHILD_REPO_B="$RW_FIXTURE/repo-b"
KEEP="${KEEP:-0}"
RUN_ACQ="${RUN_ACQ:-0}"
RUN_SBX="${RUN_SBX:-0}"
SBX_KIT_DIR="${SBX_KIT_DIR:-}"
# Container port the daemon binds (API + WS + web UI). Keep in sync with spec.
PASEO_PORT="${PASEO_PORT:-6767}"
# How long to wait for the background startup, which on FIRST boot also installs
# the Paseo CLI (npm). Override with READY_TIMEOUT.
READY_TIMEOUT="${READY_TIMEOUT:-120}"
POLL_INTERVAL="${POLL_INTERVAL:-2}"
# Once install is done the daemon should answer fast; stop waiting this many
# seconds after install completes so a broken daemon fails quickly.
POST_INSTALL_GRACE="${POST_INSTALL_GRACE:-25}"

mkdir -p "$RW_CHILD_REPO_A/.git" "$RW_CHILD_REPO_B" "$RW_FIXTURE/scratch-not-a-repo"
printf 'gitdir: /tmp/paseo-verify-repo-b.git\n' > "$RW_CHILD_REPO_B/.git"

pass=0
fail=0
ok()   { printf '  \033[32mPASS\033[0m %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }
skip() { printf '  \033[33mSKIP\033[0m %s\n' "$1"; }
warn() { printf '  \033[33mWARN\033[0m %s\n' "$1"; }
info() { printf '\n\033[1m%s\033[0m\n' "$1"; }

cleanup() {
  if [ "$KEEP" = "1" ]; then
    printf '\nKEEP=1 set; leaving sandbox %s and %s in place.\n' "$SBX_NAME" "$WORK" >&2
    return
  fi
  case "${DRIVER:-}" in
    acq) acq rm "$SBX_NAME" >/dev/null 2>&1 || true ;;
    *)   sbx rm -f "$SBX_NAME" >/dev/null 2>&1 || true ;;
  esac
  rm -rf "$WORK" "$RW_FIXTURE" "$RO_FIXTURE" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# --- Driver abstraction: exec a command inside the sandbox (non-TTY). --------
# PATH SCOPING: a bare `sh -c` sources nothing, so its PATH lacks the npm-global
# bin (where `paseo` and the real `opencode` install) and ~/.local/bin (the
# wrapper). Prepend them for every probe so PRESENT binaries resolve. Also
# include $HOME/.npm-global/bin for the per-user Paseo install path.
in_sbx() {
  _wrapped='export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$(npm prefix -g 2>/dev/null)/bin:$PATH"; '"$1"
  case "${DRIVER:-}" in
    acq) acq exec "$SBX_NAME" -- sh -c "$_wrapped" </dev/null 2>/dev/null || true ;;
    *)   sbx exec "$SBX_NAME" -- sh -c "$_wrapped" </dev/null 2>/dev/null || true ;;
  esac
}
sbx_ports_out() {
  case "${DRIVER:-}" in
    acq) acq ports "$SBX_NAME" 2>/dev/null || true ;;
    *)   sbx ports "$SBX_NAME" 2>/dev/null || true ;;
  esac
}

info "0. Preconditions"
[ -f "$KIT_DIR/spec.yaml" ] && ok "kit spec.yaml present" || { bad "spec.yaml missing"; exit 1; }

info "1. Validate the neutral kit spec"
VALIDATOR="$REPO_ROOT/integrations/isolation/acq-kits/validate-kits.py"
if ! command -v python3 >/dev/null 2>&1; then
  skip "validate-kits.py not run (python3 not on PATH)"
elif [ ! -f "$VALIDATOR" ]; then
  skip "validate-kits.py not found at $VALIDATOR"
elif ! python3 -c 'import jsonschema, yaml' >/dev/null 2>&1; then
  skip "validate-kits.py needs 'jsonschema' + 'pyyaml' — install them (pip install jsonschema pyyaml) and re-run"
else
  if val_out="$(python3 "$VALIDATOR" --root "$REPO_ROOT" 2>&1)"; then
    ok "acq-kits validate-kits.py passes (schema + registry)"
  else
    bad "validate-kits.py failed:"
    printf '%s\n' "$val_out" | sed 's/^/    | /' >&2
  fi
fi

# --- Offline check of the worktrees-root helper (no sandbox needed). ----------
info "1b. worktrees-root helper is valid + idempotent (offline)"
SETROOT="$KIT_DIR/files/home/paseo-set-worktrees-root.mjs"
if ! command -v node >/dev/null 2>&1; then
  skip "node not on PATH — cannot exercise paseo-set-worktrees-root.mjs"
elif [ ! -f "$SETROOT" ]; then
  bad "paseo-set-worktrees-root.mjs missing at $SETROOT"
elif ! node --check "$SETROOT" >/dev/null 2>&1; then
  bad "paseo-set-worktrees-root.mjs failed node --check"
else
  ok "paseo-set-worktrees-root.mjs parses (node --check)"
  _hdir="$WORK/paseo-home"; mkdir -p "$_hdir"
  _r1="$(PASEO_HOME="$_hdir" node "$SETROOT" --root /work/proj/.paseo-worktrees 2>&1)"
  _r2="$(PASEO_HOME="$_hdir" node "$SETROOT" --root /work/proj/.paseo-worktrees 2>&1)"
  if [ "$_r1" = "changed" ] && [ "$_r2" = "unchanged" ]; then
    ok "helper writes then reports idempotent (changed -> unchanged)"
  else
    bad "helper not idempotent (first='$_r1' second='$_r2', expected 'changed' then 'unchanged')"
  fi
  # Must refuse a relative root (Paseo would resolve it against PASEO_HOME).
  if PASEO_HOME="$_hdir" node "$SETROOT" --root rel/path >/dev/null 2>&1; then
    bad "helper accepted a RELATIVE root (should refuse)"
  else
    ok "helper refuses a relative root"
  fi
fi

# --- Offline check of the mount registrar helper (no sandbox needed). ----------
info "1c. mount registrar helper parses (offline)"
REGMOUNTS="$KIT_DIR/files/home/paseo-register-mounts.mjs"
if ! command -v node >/dev/null 2>&1; then
  skip "node not on PATH — cannot exercise paseo-register-mounts.mjs"
elif [ ! -f "$REGMOUNTS" ]; then
  bad "paseo-register-mounts.mjs missing at $REGMOUNTS"
elif node --check "$REGMOUNTS" >/dev/null 2>&1; then
  ok "paseo-register-mounts.mjs parses (node --check)"
else
  bad "paseo-register-mounts.mjs failed node --check"
fi

# --- Select the live driver. -------------------------------------------------
DRIVER=""
if [ "$RUN_ACQ" = "1" ]; then
  DRIVER="acq"
elif [ "$RUN_SBX" = "1" ]; then
  DRIVER="sbx"
fi

if [ -z "$DRIVER" ]; then
  info "Live sandbox checks (2-9): SKIPPED"
  echo "  Set RUN_ACQ=1 to run the live end-to-end check via acq (preferred)." >&2
  echo "  (RUN_SBX=1 also works but needs a pre-translated sbx-v2 kit; see header.)" >&2
  info "Summary"
  printf '  %d passed, %d failed\n' "$pass" "$fail"
  [ "$fail" -eq 0 ] && printf '  \033[32mOffline gate passed.\033[0m\n' || printf '  \033[31mOffline gate failed — see above.\033[0m\n'
  exit "$([ "$fail" -eq 0 ] && echo 0 || echo 1)"
fi

if ! command -v "$DRIVER" >/dev/null 2>&1; then
  echo "  RUN_${DRIVER^^}=1 set but '$DRIVER' not on PATH. Install it and retry." >&2
  exit 1
fi
echo "  driver: $DRIVER"

# --- HOST-PORT CONTENTION PRECHECK (before create). --------------------------
# On this msb build, create-time publish maps guest 6767 -> host 6767
# DETERMINISTICALLY (host_port == guest_port, host_bind 127.0.0.1), not to an
# ephemeral host port. So if ANYTHING already listens on host 6767 — a developer's
# own `paseo daemon`, OR (more subtly) ANOTHER acq/msb sandbox's own `msb`
# forwarder that already published 6767 — this verify sandbox's create-time -p
# cannot own that host port, and step 5b's HOST fetch would hit the OTHER owner:
# a false FAIL that looks like a transport bug (observed: rc=52 "Empty reply").
#
# We detect this by asking the OS who listens on the host port (lsof), NOT by
# command-name heuristics: the contender can be `msb` (another sandbox's
# forwarder), `node`/`paseo` (a bare daemon), or anything else. ANY pre-existing
# listener on the port acq will deterministically claim is a collision. We record
# it here (pre-create) so 5b/6b can SKIP with accurate guidance rather than FAIL.
# We deliberately do NOT route around it with `acq ports --publish`: that path
# tunnels via `msb ssh serve` + OpenSSH `-L` from INSIDE the guest to guest
# loopback, so it would pass even for a loopback-only bind and would not exercise
# the guest-IP create-time transport this test exists to prove.
host_port_collision=""
if command -v lsof >/dev/null 2>&1; then
  # The deterministic host port equals the guest port on this backend. Check it
  # BEFORE create so a pre-existing owner (incl. another sandbox's msb forwarder)
  # is attributable to something other than the sandbox we are about to create.
  precheck_owner="$(lsof -nP -iTCP:"$PASEO_PORT" -sTCP:LISTEN 2>/dev/null | awk 'NR>1{print $1" (pid "$2")"}' | sort -u | tr '\n' ',' | sed 's/,$//')"
  if [ -n "$precheck_owner" ]; then
    host_port_collision="$precheck_owner"
    echo "  NOTE: host port $PASEO_PORT is already in use before create by: $precheck_owner" >&2
    echo "        (commonly another acq/msb sandbox's 'msb' forwarder already publishing $PASEO_PORT," >&2
    echo "         or a local 'paseo daemon'.) The create-time host mapping will collide; step 5b" >&2
    echo "         will SKIP its host-reachability fetch. Stop that owner (e.g. 'acq rm <other-sandbox>'" >&2
    echo "         or kill the local daemon) and re-run to exercise host->guest reachability." >&2
  fi
fi

info "2. Create a sandbox with the kit"
if [ "$DRIVER" = "acq" ]; then
  echo "  creating $SBX_NAME via acq (extra kit: $KIT_DIR)..."
  echo "  extra workspaces: $RW_FIXTURE (rw), $RO_FIXTURE (ro) — exercises step 10"
  # Redirect stdin from /dev/null: `acq create` reads from the terminal (e.g. a
  # confirmation/consent prompt), which otherwise blocks the run until the user
  # hits ENTER. This script is non-interactive, so feed it EOF.
  #
  # Positional workspaces: <primary> [extra ...], with a trailing ":ro" marking a
  # read-only extra workspace (sbx/acq multi-workspace semantics; each is mounted
  # at its own absolute host path in the guest). We add one rw and one ro extra so
  # step 10 can assert the registrar registers the rw mount and SKIPS the ro one.
  if ACQ_EXTRA_KITS="$KIT_DIR" acq create --name "$SBX_NAME" opencode \
       "$WORK" "$RW_FIXTURE" "$RO_FIXTURE:ro" </dev/null >"$CREATE_LOG" 2>&1; then
    ok "sandbox created via acq (kit translated + applied)"
  else
    bad "acq create failed (exit $?)"
    sed 's/^/  | /' "$CREATE_LOG" >&2
    exit 1
  fi
  # acq reads the kit's neutral publishedPorts, so a current acq publishes 6767 at
  # CREATE time. Poll briefly (the mapping isn't necessarily queryable the instant
  # create returns, esp. on msb), then fall back to an explicit publish on older acq.
  info "2b. Container port $PASEO_PORT published at create (neutral publishedPorts)"
  PORTS_PUBLISH_TIMEOUT="${PORTS_PUBLISH_TIMEOUT:-15}"
  published=""
  pub_deadline=$(( $(date +%s) + PORTS_PUBLISH_TIMEOUT ))
  while :; do
    if sbx_ports_out | grep -q "$PASEO_PORT"; then published=yes; break; fi
    [ "$(date +%s)" -ge "$pub_deadline" ] && break
    sleep 1
  done
  if [ -n "$published" ]; then
    ok "container $PASEO_PORT auto-published at create"
  else
    warn "container $PASEO_PORT not auto-published after ${PORTS_PUBLISH_TIMEOUT}s — older acq? falling back to manual publish"
    if acq ports "$SBX_NAME" --publish "${PASEO_PORT}:${PASEO_PORT}" >/dev/null 2>&1; then
      ok "container $PASEO_PORT published via fallback (acq ports --publish)"
    else
      bad "failed to publish container $PASEO_PORT (acq ports --publish)"
    fi
  fi
else
  if [ -z "$SBX_KIT_DIR" ]; then
    info "Live sandbox checks (2-9): SKIPPED"
    echo "  RUN_SBX=1 needs a PRE-TRANSLATED sbx-v2 kit dir in SBX_KIT_DIR." >&2
    echo "  sbx cannot parse the neutral hybrid/v1 spec directly. Prefer RUN_ACQ=1," >&2
    echo "  which translates automatically." >&2
    info "Summary"
    printf '  %d passed, %d failed\n' "$pass" "$fail"
    [ "$fail" -eq 0 ] && printf '  \033[32mOffline gate passed; live checks skipped.\033[0m\n' \
      || printf '  \033[31mOffline gate failed — see above.\033[0m\n'
    exit "$([ "$fail" -eq 0 ] && echo 0 || echo 1)"
  fi
  create_kits=(--kit "$SBX_KIT_DIR")
  if [ -n "$ZSCALER_KIT_DIR" ] && [ -f "$ZSCALER_KIT_DIR/spec.yaml" ]; then
    create_kits+=(--kit "$ZSCALER_KIT_DIR")
    echo "  pairing with zscaler-ca-certificate kit at $ZSCALER_KIT_DIR"
  else
    echo "  NOTE: zscaler-ca-certificate kit not found next to this kit. On an" >&2
    echo "        HTTPS-inspected network the Paseo CLI install may fail TLS." >&2
  fi
  echo "  creating $SBX_NAME (workspace $WORK) from translated kit $SBX_KIT_DIR..."
  echo "  extra workspaces: $RW_FIXTURE (rw), $RO_FIXTURE (ro) — exercises step 10"
  dbg=(); [ "${DEBUG:-0}" = "1" ] && dbg=(-D)
  if sbx ${dbg[@]+"${dbg[@]}"} create --name "$SBX_NAME" "${create_kits[@]}" opencode \
       "$WORK" "$RW_FIXTURE" "$RO_FIXTURE:ro" </dev/null >"$CREATE_LOG" 2>&1; then
    ok "sandbox created with --kit"
  else
    bad "sbx create failed (exit $?)"
    sed 's/^/  | /' "$CREATE_LOG" >&2
    exit 1
  fi
fi

info "3. Wait for startup install + daemon (install up to ${READY_TIMEOUT}s, then ${POST_INSTALL_GRACE}s)"
# The background startup step installs the Paseo CLI on first boot, then
# supervises the daemon. Here we wait for the install and for /api/health.
deadline=$(( $(date +%s) + READY_TIMEOUT ))
installed=""; daemon_up=""; grace_deadline=""
health_probe="curl -fsS http://127.0.0.1:$PASEO_PORT/api/health >/dev/null 2>&1 && echo yes"
while :; do
  now=$(date +%s)
  [ -z "$installed" ] && [ -n "$(in_sbx 'command -v paseo')" ] && {
    installed=yes
    grace_deadline=$(( now + POST_INSTALL_GRACE ))
  }
  [ -z "$daemon_up" ] && [ "$(in_sbx "$health_probe")" = "yes" ] && daemon_up=yes
  [ -n "$installed" ] && [ -n "$daemon_up" ] && break
  [ "$now" -ge "$deadline" ] && break
  [ -n "$grace_deadline" ] && [ "$now" -ge "$grace_deadline" ] && break
  sleep "$POLL_INTERVAL"
done

if [ -n "$installed" ]; then
  ok "Paseo CLI installed by the startup step"
else
  bad "Paseo CLI not installed (see ~/.local/state/paseo/paseo-install.log)"
  in_sbx 'tail -n 25 ~/.local/state/paseo/paseo-install.log' | sed 's/^/    | /'
fi

info "4. opencode wrapper installed and shadows the real binary"
wrapper_path="$(in_sbx 'command -v opencode')"
case "$wrapper_path" in
  */.local/bin/opencode) ok "opencode resolves to the wrapper ($wrapper_path)" ;;
  "")                    bad "opencode not found on PATH in the sandbox" ;;
  *)                     bad "opencode resolves to '$wrapper_path', not ~/.local/bin/opencode (wrapper not shadowing)" ;;
esac
[ -n "$(in_sbx 'test -x ~/.local/bin/opencode && echo yes')" ] \
  && ok "wrapper file is executable" \
  || bad "~/.local/bin/opencode missing or not executable"

info "5. Paseo daemon + web UI (started by the startup supervisor, on its own)"
if [ -n "$daemon_up" ]; then
  ok "daemon answers /api/health on 127.0.0.1:$PASEO_PORT (started by the startup supervisor)"
else
  bad "daemon did not answer /api/health on :$PASEO_PORT (see the daemon log)"
  in_sbx 'tail -n 20 ~/.local/state/paseo/paseo-daemon.log' | sed 's/^/    | /'
fi
# The bundled web UI is served on the same origin: the root should return HTML.
if [ "$(in_sbx "curl -fsS http://127.0.0.1:$PASEO_PORT/ >/dev/null 2>&1 && echo yes")" = "yes" ]; then
  ok "bundled web UI is served on the same port ($PASEO_PORT)"
elif [ -n "$daemon_up" ]; then
  warn "daemon is up but the web UI root did not return 200 (PASEO_WEB_UI_ENABLED / --web-ui?)"
else
  skip "web UI check (daemon not up)"
fi

# --- Large-asset delivery over the HOST port (end-to-end integrity guard). -----
# Prove the big hashed JS bundle (~15 MB) arrives BYTE-COMPLETE over the published
# host port — the path the browser uses — not just /api/health + /.
#
# IMPORTANT test-integrity note (learned the hard way): the daemon serves this
# asset CHUNKED and offers PRECOMPRESSED variants (.gz/.br). We deliberately fetch
# with **Accept-Encoding: identity** and **without curl --compressed**, so:
#   * we get the full uncompressed body whose size we can predict exactly, and
#   * we never depend on whether THIS curl was built with brotli/zstd. Requesting
#     br/zstd against a libz-only curl yields CURLE_BAD_CONTENT_ENCODING (rc=61,
#     size=0) — a CLIENT DECODE failure that must NOT be read as truncation.
# A genuine truncation shows up as rc=18 (transfer closed) / rc=56 (reset) or a
# short byte count vs the in-guest identity baseline. (See the HOST-PORT
# CONTENTION PRECHECK before step 2 for why a contended host port SKIPs here.)
info "5b. Large UI bundle downloads intact over the HOST port (identity + br-decode)"
HOST_HP="$(sbx_ports_out | grep -Eo '127\.0\.0\.1:[0-9]+' | head -1)"
# HOST-PORT COLLISION: the pre-create precheck (before step 2) recorded whether
# something already owned the deterministic host port ($PASEO_PORT) when we
# started — e.g. another acq/msb sandbox's `msb` forwarder, or a local Paseo
# daemon. If so, this sandbox's create-time -p mapping collides and a HOST fetch
# would hit the OTHER owner, not this sandbox. SKIP (don't FAIL) in that case.
# We track host_fetch_ok so 6b reports host reachability honestly (see below).
host_fetch_ok=""
if [ -z "$daemon_up" ]; then
  skip "large-asset guard (daemon not up)"
elif ! command -v curl >/dev/null 2>&1; then
  skip "large-asset guard (no curl on the HOST to reach the published port)"
elif [ -z "$HOST_HP" ]; then
  skip "large-asset guard (could not resolve a 127.0.0.1:<port> host mapping)"
elif [ -n "$host_port_collision" ] && { [ -z "$HOST_HP" ] || [ "${HOST_HP##*:}" = "$PASEO_PORT" ]; }; then
  skip "large-asset guard (host port $PASEO_PORT was already in use BEFORE create by: $host_port_collision — commonly another acq/msb sandbox's 'msb' forwarder already publishing $PASEO_PORT, or a local 'paseo daemon'). This msb build maps guest $PASEO_PORT -> host $PASEO_PORT deterministically, so this sandbox's create-time -p collides and a HOST fetch would hit the OTHER owner. Stop it (e.g. 'acq rm <other-sandbox>' or kill the local daemon) and re-run. NOTE: do not substitute 'acq ports --publish' here — its ssh -L tunnel dials guest loopback and would not exercise the guest-IP transport this step verifies."
else
  bundle="$(in_sbx "curl -fsS http://127.0.0.1:$PASEO_PORT/ 2>/dev/null" \
            | grep -oE '/_expo/static/js/web/index-[0-9a-f]+\.js' | head -1)"
  if [ -z "$bundle" ]; then
    warn "could not find the /_expo/static/js/web/index-<hash>.js bundle in index.html; skipping"
  else
    # In-guest identity baseline (isolates the daemon from the transport).
    g_stat="$(in_sbx "curl -fsS -H 'Accept-Encoding: identity' -o /dev/null -w '%{http_code} %{size_download}' 'http://127.0.0.1:$PASEO_PORT$bundle' 2>/dev/null")"
    g_code="${g_stat%% *}"; g_size="${g_stat##* }"
    if [ "$g_code" = "200" ] && [ "${g_size:-0}" -gt 1000000 ] 2>/dev/null; then
      ok "in-guest: daemon serves the full identity bundle ($g_size bytes)"
    else
      warn "in-guest identity fetch was '$g_stat' (expected '200 <big>'); using >1MB heuristic for the host check"
      g_size=""
    fi
    # HOST end-to-end, identity, NO --compressed. Compare bytes to the baseline.
    h_out="$(curl -fsS -H 'Accept-Encoding: identity' -o /dev/null \
               -w '%{http_code} %{size_download}' "http://$HOST_HP$bundle" 2>/dev/null)"; h_rc=$?
    h_code="${h_out%% *}"; h_size="${h_out##* }"
    if [ "$h_rc" -eq 0 ] && [ "$h_code" = "200" ] && \
       { { [ -n "$g_size" ] && [ "$h_size" = "$g_size" ]; } || \
         { [ -z "$g_size" ] && [ "${h_size:-0}" -gt 1000000 ] 2>/dev/null; }; }; then
      ok "HOST end-to-end: full identity bundle delivered over $HOST_HP (${h_size} bytes)"
      host_fetch_ok=yes   # 6b gates its host-reachability assert on this
    else
      # rc=18/56 or a short count = real truncation; rc!=0 with size 0 on identity
      # is a transport error (identity needs no decoder), so it IS meaningful here.
      bad "HOST identity bundle FAILED/short over $HOST_HP (host='$h_out' rc=$h_rc vs in-guest '$g_stat'). This is a genuine transport problem (identity needs no client decoder)."
    fi

    # BROWSER-ACCURATE check: fetch the bundle with Accept-Encoding: br (what
    # Chrome sends) and actually BROTLI-DECODE it, asserting the decoded length
    # equals the identity baseline. This is the check that models the real failure
    # mode (ERR_CONTENT_DECODING_FAILED). We do the decode with node's zlib
    # (brotliDecompressSync), which the kit already depends on, so it never
    # silently SKIPs for lack of a br decoder. The host curl's own codec support
    # is irrelevant because we save the raw br bytes and decode them ourselves.
    tmp_br="$WORK/bundle.br"
    hb_out="$(curl -fsS -H 'Accept-Encoding: br' -o "$tmp_br" \
                -w '%{http_code} %{size_download}' "http://$HOST_HP$bundle" 2>/dev/null)"; hb_rc=$?
    hb_code="${hb_out%% *}"; hb_wire="${hb_out##* }"
    if [ "$hb_rc" -ne 0 ] || [ "$hb_code" != "200" ]; then
      bad "HOST br fetch failed (rc=$hb_rc code=${hb_code:-?} wire=${hb_wire:-?}) over $HOST_HP — the browser would see this as a failed asset load."
    elif ! command -v node >/dev/null 2>&1; then
      skip "br-decode check (node not on the HOST to brotli-decode; raw br wire=${hb_wire} bytes received)"
    else
      dec_len="$(BR="$tmp_br" node -e 'const z=require("zlib"),fs=require("fs");try{process.stdout.write(String(z.brotliDecompressSync(fs.readFileSync(process.env.BR)).length))}catch(e){process.stdout.write("ERR:"+e.message)}' 2>/dev/null)"
      case "$dec_len" in
        ERR:*)
          bad "HOST br bundle does NOT brotli-decode ($dec_len) — this is the ERR_CONTENT_DECODING_FAILED / black-page condition over $HOST_HP." ;;
        '' )
          skip "br-decode check (node produced no output)" ;;
        *)
          if [ -n "$g_size" ] && [ "$dec_len" != "$g_size" ]; then
            bad "HOST br bundle decoded to $dec_len bytes, expected $g_size (identity baseline) — corrupt/short br body; browser would black-page."
          elif [ "${dec_len:-0}" -gt 1000000 ] 2>/dev/null; then
            ok "HOST br bundle decodes cleanly to $dec_len bytes over $HOST_HP (models Chrome; no ERR_CONTENT_DECODING_FAILED)"
          else
            bad "HOST br bundle decoded to only $dec_len bytes over $HOST_HP — too small; browser would black-page."
          fi ;;
      esac
    fi
    rm -f "$tmp_br" 2>/dev/null || true
  fi
fi

info "6. Host port published for container $PASEO_PORT"
ports_out="$(sbx_ports_out)"
if printf '%s' "$ports_out" | grep -q "$PASEO_PORT"; then
  ok "ports maps container $PASEO_PORT to a host port"
else
  bad "no host mapping for container $PASEO_PORT in 'ports' output"
fi
printf '%s\n' "$ports_out" | sed 's/^/    | /'

info "6b. Guest daemon bind is 0.0.0.0 (reachable via create-time publish), not loopback"
# The daemon must bind 0.0.0.0:6767 in-guest so acq's CREATE-TIME port publish can
# reach it. On the msb backend `-p HOST:GUEST` binds a HOST loopback listener but
# the publisher dials the sandbox's GUEST NETWORK IP (not guest 127.0.0.1), so a
# loopback-only bind answers inside the guest yet returns "Empty reply from server"
# on the published host port. Two asserts:
#   (a) the LISTEN socket is bound to 0.0.0.0 (not 127.0.0.1) in the guest, and
#   (b) the earlier HOST-port fetch (step 5b) delivered the bundle — proving
#       acq's create-time port-publish reaches the guest daemon end-to-end.
# We read the listen address from /proc/net/tcp (hex) so we don't depend on ss/
# netstat being installed. 0100007F = 127.0.0.1; 00000000 = 0.0.0.0.
if [ -z "$daemon_up" ]; then
  skip "in-guest bind check (daemon not up)"
else
  # Port 6767 = 0x1A6F. Match a LISTEN (st=0A) row on that local port and report
  # the local address half. Prefer `ss` when present (clearer), else /proc/net/tcp.
  bind_addr="$(in_sbx '
    p=$(printf "%04X" '"$PASEO_PORT"')
    if command -v ss >/dev/null 2>&1; then
      ss -ltnH 2>/dev/null | awk -v port='"$PASEO_PORT"' "\$4 ~ (\":\" port \"\$\") {print \$4}" | head -1
    else
      # /proc/net/tcp cols: sl local_address(hex_ip:hex_port) ... st
      awk -v P="$p" "\$2 ~ (\":\" P \"\$\") && \$4==\"0A\" {print \$2}" /proc/net/tcp 2>/dev/null | head -1
    fi')"
  case "$bind_addr" in
    0.0.0.0:*|*00000000:1A6F*)
      ok "daemon LISTEN socket bound to 0.0.0.0 in-guest ($bind_addr) — reachable via create-time publish" ;;
    127.0.0.1:*|*0100007F:1A6F*)
      bad "daemon bound to loopback in-guest ($bind_addr) — create-time publish returns 'Empty reply from server' on msb; check PASEO_LISTEN" ;;
    "")
      warn "could not read the daemon's LISTEN address (no ss + unreadable /proc/net/tcp); relying on the host-port fetch as the reachability proof" ;;
    *)
      warn "unexpected daemon LISTEN address '$bind_addr' (expected 0.0.0.0:$PASEO_PORT)" ;;
  esac
  # Reachability from the host is proven ONLY by step 5b actually FETCHING the
  # bundle over the host port (host_fetch_ok). Do NOT infer reachability from the
  # mere existence of a host mapping ($HOST_HP): the create-time -p can be present
  # yet unreachable (e.g. contended by another sandbox's msb forwarder, the
  # observed rc=52 case). Report honestly per what 5b actually did.
  if [ -n "$host_fetch_ok" ]; then
    ok "reachable over the published host port (proven by step 5b fetch)"
  elif [ -n "$host_port_collision" ] && { [ -z "$HOST_HP" ] || [ "${HOST_HP##*:}" = "$PASEO_PORT" ]; }; then
    skip "host-port reachability (step 5b skipped: host port $PASEO_PORT already in use by $host_port_collision — bind is confirmed 0.0.0.0 above; host reachability not exercised)"
  else
    skip "host-port reachability (step 5b did not complete a successful host fetch — see 5b above; bind is confirmed 0.0.0.0)"
  fi
fi

info "6c. Hardening: install ran with lifecycle scripts disabled (--ignore-scripts)"
# wz-gsa hardening #2: npm_config_ignore_scripts=true blocks preinstall/install/
# postinstall exec vectors. We assert BOTH that the CLI still works (step 3 already
# confirms `paseo` resolves) AND that the setting was actually in force — the
# install log records the npm config when scripts are skipped. This guards against
# a silent regression that drops the flag.
if [ -z "$installed" ]; then
  skip "ignore-scripts check (Paseo CLI did not install)"
else
  ok "Paseo CLI is usable despite --ignore-scripts (bin link intact; see step 3)"
  # `paseo --version` (or `daemon status`) proves the top-level bin is linked and
  # runnable, which is the concrete risk of --ignore-scripts (a package that needs
  # a postinstall to be usable). The daemon being up (step 5) already exercises it.
  ver_ok="$(in_sbx 'paseo --version >/dev/null 2>&1 && echo yes')"
  if [ "$ver_ok" = "yes" ]; then
    ok "paseo binary runs (\`paseo --version\`) — no required postinstall was skipped"
  else
    warn "\`paseo --version\` did not run cleanly; if the daemon is also down, a required lifecycle script may have been skipped — drop --ignore-scripts in paseo-start.sh"
  fi
fi

info "6d. Hardening: npm cache remains agent-owned"
# Regression guard for running npm as root while HOME=/home/agent: that creates
# root-owned files under ~/.npm and later blocks ordinary agent npm commands. Run
# this even when install fails, because stale root-owned cache files may be the
# reason install failed.
bad_cache_owner="$(in_sbx 'if [ -d "$HOME/.npm" ]; then find "$HOME/.npm" -not -user "$(id -u)" -print -quit 2>/dev/null; fi')"
if [ -n "$bad_cache_owner" ]; then
  bad "npm cache contains files not owned by the agent user: $bad_cache_owner"
else
  ok "npm cache has no non-agent-owned files under ~/.npm"
fi

info "7. Respawn supervisor running (auto-restart) — the daemon"
# The daemon runs under a respawn loop marked "supervisor:paseo-daemon" in its
# argv. Assert EXACTLY one is alive (guards a duplicate respawner on re-runs).
# Bracket-trick avoids matching this probe's own argv.
daemon_sup="$(in_sbx 'pgrep -c -f "supervisor:paseo[-]daemon" 2>/dev/null')"
case "${daemon_sup:-0}" in
  1) ok "paseo-daemon supervisor running (exactly one)" ;;
  0) bad "no paseo-daemon supervisor found (daemon auto-restart not active)" ;;
  *) bad "found ${daemon_sup} paseo-daemon supervisors (expected 1 — duplicate respawner?)" ;;
esac

info "8. Entrypoint holds PID 1 when it IS the entrypoint, exits cleanly otherwise — regression guard"
# The kit's entrypoint behavior is split: a thin per-agent wrapper
# (~/.local/bin/opencode) that either passes through to the real agent binary or
# EXECs the generic shim (~/paseo-agent-shim), and the shim, which carries the
# PID-1 hold. We check three invariants:
#   (a) the thin wrapper EXECs the shim on the no-arg path (so the shim inherits
#       the wrapper's pid — PID 1 on the `acq run` path; a child would break hold);
#   (b) the shim discriminates on `$$ -eq 1` and calls hold_pid1 on that branch;
#   (c) live: run the wrapper no-arg + no-TTY via exec (NOT PID 1) and confirm it
#       RETURNS promptly rather than hanging.
wrapper_src="$(in_sbx 'cat ~/.local/bin/opencode 2>/dev/null')"
shim_src="$(in_sbx 'cat ~/paseo-agent-shim 2>/dev/null')"
if [ -z "$wrapper_src" ]; then
  bad "could not read ~/.local/bin/opencode from the sandbox"
elif printf '%s\n' "$wrapper_src" | grep -Eq 'exec[[:space:]]+sh[[:space:]]+"?\$SHIM"?|exec[[:space:]]+sh[[:space:]]+.*paseo-agent-shim'; then
  ok "thin wrapper execs the generic shim on the no-arg path (preserves PID for the hold)"
else
  bad "thin wrapper does not exec the shim — no-arg path won't inherit PID 1, breaking the hold"
fi
if [ -z "$shim_src" ]; then
  bad "could not read ~/paseo-agent-shim from the sandbox to check the PID-1 discriminator"
else
  if printf '%s\n' "$shim_src" | grep -Eq '\$\$"?[[:space:]]*-eq[[:space:]]*1'; then
    ok "shim discriminates on PID 1 (\$\$ -eq 1) before deciding to hold vs. exit"
  else
    bad "shim has no \$\$ -eq 1 check — it cannot tell the acq run (PID 1) path from acq exec"
  fi
  if printf '%s\n' "$shim_src" | grep -Eq '^[[:space:]]*hold_pid1[[:space:]]*$'; then
    ok "shim calls hold_pid1 on the PID-1 branch"
  else
    bad "shim does not call hold_pid1 — the acq run entrypoint could return and stop the sandbox"
  fi
fi
wrapper_probe="$(in_sbx '
  if command -v timeout >/dev/null 2>&1; then
    timeout 20 opencode </dev/null >/dev/null 2>&1
    echo "rc=$?"
  else
    echo "rc=notimeout"
  fi
')"
case "$wrapper_probe" in
  *rc=124*)      bad "entrypoint HUNG when NOT PID 1 (via exec); it should exit cleanly on that path" ;;
  *rc=notimeout*) skip "could not run the wrapper-exit probe (no 'timeout' in sandbox)" ;;
  *)             ok "wrapper exits cleanly when NOT PID 1 (${wrapper_probe})" ;;
esac

info "9. Worktree root pinned under the project + daemon self-heals — regression guards"
# (a) worktree-root pin: running the wrapper no-arg from the PRIMARY WORKSPACE cwd
#     should set worktrees.root to <workspace>/.paseo-worktrees in config.json.
#
#     WHERE IS THE PRIMARY WORKSPACE INSIDE THE GUEST? acq bind-mounts the first
#     positional path at the SAME (canonicalized) absolute path in the guest, and
#     runs the agent there via `exec -w <path>` — it does NOT remap to
#     /home/agent/workspace (that Workdir in `msb inspect` is inert base-image
#     metadata acq bypasses). The canonical path acq used is recorded in the guest
#     file /var/lib/acq/workspace; that is the cwd the real entrypoint gets. On
#     macOS the canonical path differs from $WORK only by the /var -> /private/var
#     symlink, so we read the guest's recorded value (authoritative) and fall back
#     to $WORK. Run the wrapper from that cwd, then read back config.json.
GUEST_WS="${GUEST_WS:-}"
if [ -z "$GUEST_WS" ]; then
  GUEST_WS="$(in_sbx 'cat /var/lib/acq/workspace 2>/dev/null')"
  [ -n "$GUEST_WS" ] || GUEST_WS="$WORK"
fi
# Run the wrapper from the guest workspace cwd, then read back config.json.
pin_out="$(in_sbx "cd '$GUEST_WS' 2>/dev/null && (command -v timeout >/dev/null 2>&1 && timeout 30 opencode </dev/null >/dev/null 2>&1; true); cat \"\${PASEO_HOME:-\$HOME/.paseo}/config.json\" 2>/dev/null")"
if printf '%s' "$pin_out" | grep -q "\"root\": \"$GUEST_WS/.paseo-worktrees\""; then
  ok "worktrees.root pinned under the project ($GUEST_WS/.paseo-worktrees)"
elif printf '%s' "$pin_out" | grep -Eq '"root": *"[^"]*/\.paseo-worktrees"'; then
  # It IS pinned to some <dir>/.paseo-worktrees, just not the exact dir we probed.
  # That still proves the mechanism; surface the actual value and pass.
  _actual="$(printf '%s' "$pin_out" | grep -Eo '"root": *"[^"]*/\.paseo-worktrees"' | head -1)"
  ok "worktrees.root pinned under a project dir ($_actual); differs from probed cwd '$GUEST_WS'"
else
  bad "worktrees.root not pinned to any <project>/.paseo-worktrees — config.json was:"
  printf '%s\n' "$pin_out" | sed 's/^/    | /'
fi

# (b) daemon self-heal: if the daemon dies, supervisor:paseo-daemon must relaunch
#     it. Kill ONLY the daemon tree (argv matches "paseo daemon start" but NOT the
#     supervisor marker), assert the supervisor survives and the daemon comes back.
if [ -z "$daemon_up" ]; then
  skip "self-heal guard: daemon was not up to kill"
else
  sup_before="$(in_sbx 'pgrep -u "$(id -u)" -f "supervisor:paseo-daemon" | sort | tr "\n" " "')"
  in_sbx '
    for pid in $(pgrep -u "$(id -u)" -f "paseo daemon start"); do
      if tr "\0" " " </proc/"$pid"/cmdline 2>/dev/null | grep -q "supervisor:paseo-daemon"; then
        continue
      fi
      kill "$pid" 2>/dev/null
    done
    echo killed
  ' >/dev/null
  sup_after="$(in_sbx 'pgrep -u "$(id -u)" -f "supervisor:paseo-daemon" | sort | tr "\n" " "')"
  if [ -z "$sup_after" ]; then
    bad "the paseo-daemon SUPERVISOR was killed by the probe — kill was not precise enough"
  else
    ok "paseo-daemon supervisor survived the kill (before='$sup_before' after='$sup_after')"
  fi
  healed=""
  heal_deadline=$(( $(date +%s) + 45 ))   # RESTART_DELAY (5s) + daemon readiness
  while :; do
    [ "$(in_sbx "$health_probe")" = "yes" ] && { healed=yes; break; }
    [ "$(date +%s)" -ge "$heal_deadline" ] && break
    sleep "$POLL_INTERVAL"
  done
  if [ -n "$healed" ]; then
    ok "daemon was re-launched after being killed (supervisor:paseo-daemon self-healed)"
  else
    bad "daemon did NOT come back after being killed — supervisor:paseo-daemon not respawning"
    in_sbx 'tail -n 20 ~/.local/state/paseo/paseo-daemon.log' | sed 's/^/    | /'
  fi
fi

info "10. Projects pre-populated from the mounted host directories"
# The startup registrar (paseo-register-mounts.mjs) registers each read-write
# host project directory mounted into the sandbox with the daemon. If a mount is
# a plain parent directory containing direct child Git repos, those child repos
# are registered instead of the parent; mounts without child repos still fall
# back to the mount itself. Assert that EVERY expected project shows up in the
# daemon's registry, and — using the rw/ro fixtures we mounted at create (step 2)
# — that a READ-ONLY mount is SKIPPED while child repos under a READ-WRITE parent
# are REGISTERED. We derive the expected set the same backend-agnostic way the
# helper does — from /proc/mounts inside the guest — so the test does not
# hard-code msb/sbx mount source names.
#
# We read the registered projects from the daemon's own API (the same
# `client.listProjects()` the registrar's client library speaks), NOT from the
# on-disk projects.json. Scraping the file would couple this test to Paseo's
# internal storage layout (path, key name, JSON spacing); querying the API is the
# supported surface and returns each project's root as `projectRootPath`. See the
# ADR "Consequences" note on this coupling.
if [ -z "$daemon_up" ]; then
  skip "project pre-population check (daemon not up)"
else
  # Fetch the set of registered project root paths from the daemon API, one per
  # line. Runs in-guest via the CLI's bundled client (connectToDaemon), resolved
  # portably from the `paseo` bin — the same connector the registrar uses.
  list_project_roots() {
    in_sbx '
      CLIENT="$(node -e "process.stdout.write(require(\"path\").dirname(require(\"path\").dirname(require(\"fs\").realpathSync(require(\"child_process\").execFileSync(\"sh\",[\"-c\",\"command -v paseo\"]).toString().trim()))))" 2>/dev/null)/dist/utils/client.js"
      [ -f "$CLIENT" ] || exit 0
      CLIENT_URL="file://$CLIENT" node --input-type=module -e "
        const { connectToDaemon } = await import(process.env.CLIENT_URL);
        const c = await connectToDaemon({});
        try {
          const r = await c.listProjects();
          for (const p of r.projects ?? []) {
            const root = p.projectRootPath ?? p.rootPath;
            if (root) process.stdout.write(root + \"\n\");
          }
        } finally { await c.close().catch(() => {}); }
      " 2>/dev/null'
  }

  rw_base="$(basename "$RW_FIXTURE")"
  rw_child_a_base="$(basename "$RW_CHILD_REPO_A")"
  rw_child_b_base="$(basename "$RW_CHILD_REPO_B")"
  ro_base="$(basename "$RO_FIXTURE")"

  # Expected set: qualifying rw virtiofs mounts, expanded by the actual registrar
  # helper so this live check cannot drift from paseo-register-mounts.mjs.
  expected_projects="$(in_sbx '
    node --input-type=module -e "
      import { readFileSync, statSync } from \"node:fs\";
      import { basename } from \"node:path\";
      import { projectDirsFromMounts } from \"file://$HOME/paseo-register-mounts.mjs\";
      const systemPrefixes = [\"/etc\", \"/run\", \"/proc\", \"/sys\", \"/dev\"];
      const unescapeMountField = (field) => field.replace(/\\\\(\\d{3})/g, (_, oct) => String.fromCharCode(parseInt(oct, 8)));
      const underSystemPrefix = (target) => target === \"/\" || systemPrefixes.some((prefix) => target === prefix || target.startsWith(prefix + \"/\"));
      const mounts = [];
      for (const line of readFileSync(\"/proc/mounts\", \"utf8\").split(\"\\n\")) {
        if (!line) continue;
        const parts = line.split(/\\s+/);
        if (parts.length < 4 || parts[2] !== \"virtiofs\" || !parts[3].startsWith(\"rw\")) continue;
        const target = unescapeMountField(parts[1]);
        if (underSystemPrefix(target) || basename(target).startsWith(\".\")) continue;
        try { if (!statSync(target).isDirectory()) continue; } catch { continue; }
        mounts.push(target);
      }
      for (const project of projectDirsFromMounts(mounts).sort()) process.stdout.write(project + \"\\n\");
    "')"
  if [ -z "$expected_projects" ]; then
    bad "no read-write host project mounts found in the guest — the primary + rw fixture should be present"
    in_sbx 'grep virtiofs /proc/mounts' | sed 's/^/    | /'
  else
    # The registrar runs in the background after /api/health; give it a bounded
    # window to finish, then read the registered projects from the daemon API.
    reg_deadline=$(( $(date +%s) + 60 ))
    project_roots=""
    missing=""
    while :; do
      project_roots="$(list_project_roots)"
      missing=""
      for m in $expected_projects; do
        printf '%s\n' "$project_roots" | grep -qx "$m" || missing="$missing $m"
      done
      [ -z "$missing" ] && break
      [ "$(date +%s)" -ge "$reg_deadline" ] && break
      sleep "$POLL_INTERVAL"
    done
    if [ -z "$missing" ]; then
      _n="$(printf '%s\n' "$expected_projects" | grep -c .)"
      ok "all $_n expected project path(s) registered as projects (via daemon API)"
    else
      bad "some host project mounts were not registered:$missing"
      in_sbx 'tail -n 20 ~/.local/state/paseo/paseo-register.log 2>/dev/null' | sed 's/^/    | /'
    fi

    # POSITIVE: child repos under the read-write parent fixture must be registered.
    if printf '%s\n' "$project_roots" | grep -q "${rw_base}/${rw_child_a_base}\$" && \
       printf '%s\n' "$project_roots" | grep -q "${rw_base}/${rw_child_b_base}\$"; then
      ok "child repos under read-write parent fixture ($rw_base) registered as projects"
    else
      bad "child repos under read-write parent fixture ($rw_base) were NOT registered"
    fi

    # NEGATIVE: the parent fixture should not be registered when direct child repos
    # were found and registered instead.
    if printf '%s\n' "$project_roots" | grep -q "${rw_base}\$"; then
      bad "read-write parent fixture ($rw_base) was registered instead of only its child repos"
    else
      ok "read-write parent fixture ($rw_base) correctly expanded to child repos"
    fi

    # NEGATIVE: the read-only fixture must be SKIPPED. Only assert this if the
    # guest actually mounted it read-only (guard against a backend that ignores
    # :ro — in which case we skip rather than falsely fail).
    ro_is_ro="$(in_sbx "awk '\$3==\"virtiofs\" && \$4 ~ /^ro/ && \$2 ~ /${ro_base}\$/ {print \"yes\"}' /proc/mounts | head -1")"
    if [ "$ro_is_ro" = "yes" ]; then
      if printf '%s\n' "$project_roots" | grep -q "${ro_base}\$"; then
        bad "read-only fixture ($ro_base) was wrongly registered (should be skipped)"
      else
        ok "read-only fixture ($ro_base) correctly skipped"
      fi
    else
      skip "read-only skip assertion (guest did not mount $ro_base read-only; got: '${ro_is_ro:-not virtiofs}')"
    fi

    # NEGATIVE: the backend runtime dir (/.msb, a dotdir) must NOT be a project.
    if printf '%s\n' "$project_roots" | grep -qx "/.msb"; then
      bad "backend runtime dir /.msb was wrongly registered as a project"
    else
      ok "backend runtime dir (/.msb) correctly excluded"
    fi
  fi
fi

info "Summary"
[ "$fail" -eq 0 ] && printf '  \033[32mAll checks passed.\033[0m\n' || printf '  \033[31mSome checks failed — see notes above.\033[0m\n'

[ "$fail" -eq 0 ]
