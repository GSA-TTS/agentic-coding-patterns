#!/usr/bin/env bash
#
# paseo-backup — snapshot a running sandbox's Paseo state to a host tar so it
# survives sandbox recreation (`acq rm` + a fresh `acq create`/`acq run`).
#
# WHAT THIS SOLVES: an acq sandbox is an ephemeral container. Everything under
# the guest home — including $PASEO_HOME (default ~/.paseo): config.json, the
# projects registry (projects/projects.json), and Paseo's session/agent metadata
# — is LOST when the sandbox is destroyed. Only host bind mounts survive. This
# script copies $PASEO_HOME out to the host BEFORE teardown; the companion
# `paseo-restore` replays it into a new sandbox afterward.
#
# WHAT IS AND IS NOT CAPTURED:
#   - Captured: the $PASEO_HOME tree (config.json, projects/, agents/, session
#     records, and any other state Paseo persists there) MINUS the exclusions
#     below.
#   - Excluded:
#       * paseo.pid — supervisor PID lock; the daemon recreates it on boot.
#       * daemon.log and rotated daemon logs — live/runtime noise that can bloat
#         the archive and make restore look hung over acq's text transport.
#       * daemon-keypair.json, cli-client-id, server-id — per-daemon/-install
#         identity the daemon regenerates on first boot; carrying it into a
#         DIFFERENT sandbox is pointless at best.
#       * models/ — downloaded model caches (e.g. a ~460MB speech model). Large,
#         re-downloadable, and not state; excluding it keeps the archive small.
#   - NOT captured: git worktree CONTENTS. The kit pins Paseo's worktrees under
#     <primary-project>/.paseo-worktrees, i.e. inside a host bind mount, so the
#     worktree files ALREADY survive recreation on their own (as long as the
#     project is re-mounted at the same guest path). What is lost without this
#     backup is Paseo's KNOWLEDGE of them (its session/worktree records under
#     $PASEO_HOME) — restoring this snapshot is exactly what makes Paseo
#     re-recognize the on-disk worktrees.
#     See docs/decisions/backup-restore-paseo-state.md.
#
# FILENAME CONTRACT (consumed by paseo-restore's newest-backup default):
#   <dest>/paseo-state-<sandbox>-<UTC>.tar
# where <UTC> is a colon-free ISO-8601 basic timestamp (YYYYMMDDTHHMMSSZ) that
# sorts lexicographically by time. paseo-restore picks the lexicographically
# last file matching this sandbox prefix as "most recent", so DO NOT change this
# naming without updating paseo-restore in lockstep.
#
# SAFETY: dry-run by default. It only reports what it WOULD capture until you
# pass --apply. Even the capture is read-only against the sandbox (a `tar -cf -`
# streamed over `acq exec` stdout); it never mutates guest state.
#
# Usage:
#   paseo-backup [--apply] <sandbox> [dest-dir]
#   paseo-backup --help
#
# Requires the `acq` CLI on PATH and a RUNNING sandbox named <sandbox>.

set -euo pipefail
IFS=$'\n\t'

APPLY=0
SANDBOX=""
DEST_DIR=""
DEFAULT_DEST="${HOME}/.acq-paseo-backups"
TMP_OUT=""
TMP_ERR=""
TMP_B64=""

usage() {
  cat <<'EOF'
Usage: paseo-backup [--apply] <sandbox> [dest-dir]

Snapshot a running acq sandbox's Paseo state ($PASEO_HOME, minus its PID lock,
live log, and per-install identity files) to a host tar so it survives sandbox
recreation.

Arguments:
  <sandbox>    Name of the running acq sandbox to back up.
  [dest-dir]   Host directory to write the tar into.
               Default: ~/.acq-paseo-backups

Options:
  --apply      Actually create the backup. Without it, this is a dry run that
               only prints what it would do.
  --help       Show this help.

Output file (naming is a contract with paseo-restore):
  <dest-dir>/paseo-state-<sandbox>-<UTC>.tar   (UTC = YYYYMMDDTHHMMSSZ)
EOF
}

# Sandbox name flows into a filename and an `acq exec` target, so constrain it to
# a safe charset rather than trusting arbitrary input (SI-10).
valid_sandbox_name() {
  case "$1" in
    "" | *[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)
      APPLY=1
      shift
      ;;
    --help | -h)
      usage
      exit 0
      ;;
    -*)
      echo "Error: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -z "${SANDBOX}" ]]; then
        SANDBOX="$1"
      elif [[ -z "${DEST_DIR}" ]]; then
        DEST_DIR="$1"
      else
        echo "Error: unexpected extra argument: $1" >&2
        usage >&2
        exit 2
      fi
      shift
      ;;
  esac
done

if [[ -z "${SANDBOX}" ]]; then
  echo "Error: <sandbox> is required." >&2
  usage >&2
  exit 2
fi
if ! valid_sandbox_name "${SANDBOX}"; then
  echo "Error: sandbox name '${SANDBOX}' has characters outside [A-Za-z0-9._-]." >&2
  exit 2
fi
if ! command -v acq >/dev/null 2>&1; then
  echo "Error: the 'acq' CLI is not on PATH." >&2
  exit 2
fi

DEST_DIR="${DEST_DIR:-${DEFAULT_DEST}}"

# Colon-free UTC timestamp so the filename is valid on every filesystem AND sorts
# lexicographically by time (paseo-restore relies on that ordering).
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
OUT_FILE="${DEST_DIR}/paseo-state-${SANDBOX}-${STAMP}.tar"

# The guest-side capture. Resolve $PASEO_HOME exactly like the kit's own helpers
# (${PASEO_HOME:-$HOME/.paseo}) and emit a base64-encoded tar of its contents to
# stdout. Read-only against the sandbox.
#
# WHY THIS IS NOT A PLAIN `tar -cf - .`: two independent problems, both fixed
# here so the capture is backend-agnostic (works over msb AND sbx via acq).
#
#   1. LIVE-FILE CHURN. The daemon writes under $PASEO_HOME while we read it, and
#      GNU tar treats a file changing mid-read as an error — exit 1 ("file
#      changed as we read it") or 2 for a whole entry — WHILE STILL emitting a
#      valid archive of everything else. We observed rc=2 on a live sandbox.
#      Fix: snapshot to a guest TEMP FILE with churn tolerated
#      (--warning=no-file-changed, --ignore-failed-read), and classify tar's exit
#      code (0 clean; 1/2 expected churn; >=3 real failure → abort).
#
#   2. BINARY STDIN/STDOUT OVER acq. `acq exec` was observed to hang on a RAW
#      BINARY stream (a guest `cat | wc -c` never saw EOF), while multi-line TEXT
#      reaches EOF normally. So we do NOT stream raw tar bytes: the guest
#      base64-ENCODES the archive to stdout, and the host base64-DECODES it. The
#      restore side mirrors this (host encodes, guest decodes). base64 keeps the
#      payload in acq's safe text channel on both backends.
#
# EXCLUSIONS (paths are relative to the -C dir, i.e. $PASEO_HOME root):
#   - paseo.pid        — supervisor PID lock; recreated on boot.
#   - daemon.log, daemon.log.*, *-daemon.log, daemon.log.txt — live/runtime
#                        log artifacts; pure noise and the most churn-prone files.
#   - daemon-keypair.json, cli-client-id, server-id — per-daemon/-install
#                        identity the daemon regenerates on first boot; carrying
#                        it into a DIFFERENT sandbox is pointless at best.
#   - models/          — downloaded model caches (e.g. the ~460MB sherpa-onnx
#                        speech model). Large, re-downloadable, NOT state. Leaving
#                        it in bloats the archive to hundreds of MB and makes the
#                        base64 transport crawl; the daemon re-fetches on demand.
GUEST_CAPTURE='
  set -eu
  PH="${PASEO_HOME:-$HOME/.paseo}"
  if [ ! -d "$PH" ]; then
    echo "paseo-backup: $PH does not exist in the sandbox" >&2
    exit 3
  fi
  TMP="$(mktemp "${TMPDIR:-/tmp}/paseo-backup.XXXXXX.tar")"
  trap "rm -f \"$TMP\"" EXIT INT TERM
  rc=0
  tar -C "$PH" \
    --warning=no-file-changed \
    --ignore-failed-read \
    --exclude ./paseo.pid \
    --exclude ./daemon.log \
    --exclude ./daemon.log.* \
    --exclude ./daemon.log.txt \
    --exclude ./*-daemon.log \
    --exclude ./daemon-keypair.json \
    --exclude ./cli-client-id \
    --exclude ./server-id \
    --exclude ./models \
    -cf "$TMP" . || rc=$?
  # rc 0 = clean; 1/2 = files changed/vanished during read (expected here, the
  # archive is still usable); >=3 = fatal — abort.
  if [ "$rc" -ge 3 ]; then
    echo "paseo-backup: tar failed with exit $rc" >&2
    exit "$rc"
  fi
  base64 < "$TMP"
'

cleanup() {
  if [[ -n "${TMP_OUT}" && -f "${TMP_OUT}" ]]; then
    rm -f "${TMP_OUT}"
  fi
  if [[ -n "${TMP_ERR}" && -f "${TMP_ERR}" ]]; then
    rm -f "${TMP_ERR}"
  fi
  if [[ -n "${TMP_B64}" && -f "${TMP_B64}" ]]; then
    rm -f "${TMP_B64}"
  fi
}
trap cleanup EXIT INT TERM

if [[ "${APPLY}" -ne 1 ]]; then
  cat <<EOF
[dry-run] would back up Paseo state from sandbox '${SANDBOX}'.
[dry-run]   source (in guest): \${PASEO_HOME:-\$HOME/.paseo} (excluding the PID lock, live log, and identity files)
[dry-run]   destination file:  ${OUT_FILE}
[dry-run] no files written and the sandbox is untouched.
[dry-run] re-run with --apply to create the backup.
EOF
  exit 0
fi

mkdir -p "${DEST_DIR}"

if ! command -v base64 >/dev/null 2>&1; then
  echo "Error: 'base64' is required on the host to decode the archive." >&2
  exit 2
fi

# The guest emits the archive as base64 TEXT (raw binary over acq stdin/stdout
# hangs — see the GUEST_CAPTURE header). Capture that text to a temp file, then
# decode it into the final .tar and atomically rename on success — an interrupted
# or failed capture never leaves a truncated .tar that paseo-restore might later
# pick as "most recent".
TMP_B64="$(mktemp "${DEST_DIR}/.paseo-state-${SANDBOX}.b64.XXXXXX")"
TMP_OUT="$(mktemp "${DEST_DIR}/.paseo-state-${SANDBOX}.tar.XXXXXX")"
# Capture the guest's stderr separately so we can surface the ACTUAL cause (e.g.
# "$PASEO_HOME does not exist", an acq error, a permission problem) rather than a
# generic guess.
TMP_ERR="$(mktemp "${DEST_DIR}/.paseo-state-${SANDBOX}.err.XXXXXX")"

# Run the capture. acq faithfully propagates the guest exit code (verified), and
# the guest capture above exits 0 for the expected file-churn conditions and
# non-zero only for a real failure — so we CAN branch on the exit code. Redirect
# stdin from /dev/null so acq never blocks on a TTY; keep guest stderr for
# diagnostics.
acq_rc=0
acq exec "${SANDBOX}" -- sh -c "${GUEST_CAPTURE}" \
  </dev/null >"${TMP_B64}" 2>"${TMP_ERR}" || acq_rc=$?

if [[ "${acq_rc}" -ne 0 ]]; then
  echo "Error: backing up '${SANDBOX}' failed (exit ${acq_rc}). The sandbox / acq reported:" >&2
  if [[ -s "${TMP_ERR}" ]]; then
    sed 's/^/    | /' "${TMP_ERR}" >&2
  else
    echo "    | (no error output — is 'acq' on PATH and the sandbox running?)" >&2
  fi
  exit 1
fi

if [[ ! -s "${TMP_B64}" ]]; then
  echo "Error: captured an empty archive from '${SANDBOX}'. Nothing was written." >&2
  if [[ -s "${TMP_ERR}" ]]; then
    echo "The sandbox / acq reported:" >&2
    sed 's/^/    | /' "${TMP_ERR}" >&2
  else
    echo "    (\$PASEO_HOME may be absent, or the sandbox may not be running.)" >&2
  fi
  exit 1
fi

# Decode the base64 text into the real tar.
if ! base64 -d <"${TMP_B64}" >"${TMP_OUT}" 2>/dev/null; then
  echo "Error: could not base64-decode the captured stream; refusing to keep it." >&2
  exit 1
fi

# Sanity-check that we actually got a readable tar before promoting it.
if ! tar -tf "${TMP_OUT}" >/dev/null 2>&1; then
  echo "Error: decoded data is not a valid tar archive; refusing to keep it." >&2
  if [[ -s "${TMP_ERR}" ]]; then
    echo "The sandbox / acq reported:" >&2
    sed 's/^/    | /' "${TMP_ERR}" >&2
  fi
  exit 1
fi

mv "${TMP_OUT}" "${OUT_FILE}"
TMP_OUT=""

BYTES="$(wc -c <"${OUT_FILE}" | tr -d ' ')"
echo "Backed up Paseo state from '${SANDBOX}' to:"
echo "  ${OUT_FILE} (${BYTES} bytes)"
echo "Restore it into a new sandbox with:  paseo-restore --apply ${SANDBOX}"
