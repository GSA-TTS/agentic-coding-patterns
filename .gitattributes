# Byte-compared generated artifacts must stay LF in the working tree. Tests and
# the refresh/--check drift gates compare generator output (always LF) against
# these files byte for byte, so a checkout with core.autocrlf=true (the Git for
# Windows default) would otherwise rewrite them to CRLF and fail the comparison.
# The runtime preparation artifact is generated by build-runtime-artifact.mjs from
# a closed list of source modules, and that script rewrites `import ... from "..."`
# lines by matching an LF right after the closing quote, so the sources must be LF
# too or `build-runtime-artifact.mjs --check` fails with a CRLF checkout.
# Scope is deliberately narrow: only files that are compared as bytes or text.
integrations/isolation/schemas/fixtures/*/snapshot.json text eol=lf
integrations/isolation/acq-kits/usai-provider/files/home/usai-config/model-catalog-snapshot.json text eol=lf
integrations/providers/usai/catalog.json text eol=lf
integrations/providers/usai/tests/fixtures/refresh/artifacts/catalog.json text eol=lf
integrations/providers/usai/tests/fixtures/refresh/artifacts/snapshot.json text eol=lf
